@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix mem:    <https://pod.vardeman.me/vault/ontology/mem#> .
@prefix schema: <https://schema.org/> .

<> dct:conformsTo <https://www.w3.org/TR/shacl/> .

# ARM A — presence-only floor. The shape requires mem:rationale to EXIST but
# says nothing about what a good one contains.
<#ProbeNoteShape>
    a sh:NodeShape ;
    rdfs:label "Probe note write contract" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/probe-w/note.shacl.ttl> ;
    sh:targetClass schema:Report ;
    sh:agentInstruction """A note in this container is a schema:Report carrying
schema:name (a title), schema:text (the finding itself), and mem:rationale
(a string). All three are required.""" ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "schema:name is required." ;
    ] ;
    sh:property [
        sh:path schema:text ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "schema:text is required." ;
    ] ;
    sh:property [
        sh:path mem:rationale ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "mem:rationale is required." ;
    ] .
