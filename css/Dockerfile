FROM solidproject/community-server:next

# git is required by the memento extension (shells out to `git log`, `git show`,
# `git add`, `git commit` against /data). Base image is Alpine; install via apk.
USER root
RUN apk add --no-cache git

# ============================================================================
# shape-validator-component — SHACL validation on write per container
# ============================================================================

COPY extensions/shape-validator /community-server/extensions/shape-validator

# Install only the direct dependency (rdf-validate-shacl)
# Peer deps (CSS, n3, asynchronous-handlers) resolve from parent node_modules at runtime
RUN cd extensions/shape-validator && npm install --ignore-scripts rdf-validate-shacl componentsjs-generator typescript

# Build TypeScript
RUN cd extensions/shape-validator && npx tsc --skipLibCheck

# Generate Components.js context
RUN cd extensions/shape-validator && npx componentsjs-generator -s src -c dist/components

# Symlink into node_modules so Components.js discovers it
RUN ln -sf /community-server/extensions/shape-validator /community-server/node_modules/shape-validation-component

# ============================================================================
# markdown-render — custom markdown→HTML converter with wikilink resolution
# (D75: rendered HTML for humans; no RDFa; renamed from markdown-rdfa)
#
# Replaces the default MarkdownToHtmlConverter. The converter class is a CJS
# wrapper (dist-cjs/converter.js) that lazy-loads the ESM render pipeline
# (dist/render.js) via dynamic import(). Components.js metadata is hand-
# written under dist-cjs/ — we intentionally skip componentsjs-generator
# because it can't parse dynamic import expressions correctly.
# ============================================================================

# shared — markdown-parsing utilities (wikilinks, resolver, predicates) used by
# both markdown-render and markdown-projection. Must be copied and installed
# before either extension builds because their tsconfig rootDir=../.. includes
# ../shared/markdown-parsing/src/*.ts, which imports unified/unist types.
COPY extensions/shared /community-server/extensions/shared
RUN cd extensions/shared/markdown-parsing && npm install --ignore-scripts

COPY extensions/markdown-render /community-server/extensions/markdown-render

# Install runtime deps for the ESM rendering pipeline (unified/remark/rehype)
# plus build-time typescript. @solid/community-server is installed as a
# devDependency so tsc can type-check against its declarations.
RUN cd extensions/markdown-render && npm install --ignore-scripts

# Build both ESM pipeline (src/ → dist/) and CJS wrapper (src-cjs/ → dist-cjs/)
RUN cd extensions/markdown-render && npm run build

# CRITICAL: replace the extension's @solid/community-server copy with a
# symlink to the host CSS. We need it at build time for type checking, but at
# runtime Node must resolve @solid/community-server to the SAME file CSS
# itself uses, so that the classes our converter imports (especially
# RepresentationMetadata and BasicRepresentation) have the same identity as
# the classes CSS passes through its pipeline. Two separate copies → two
# separate class definitions → isRepresentationMetadata(...) returns false
# inside BasicRepresentation's constructor → falls into the wrong branch →
# "premature close" on the response pipe.
RUN rm -rf /community-server/extensions/markdown-render/node_modules/@solid/community-server && \
    ln -sf /community-server /community-server/extensions/markdown-render/node_modules/@solid/community-server

# Symlink into node_modules so Components.js require('markdown-render') resolves
RUN ln -sf /community-server/extensions/markdown-render /community-server/node_modules/markdown-render

# ============================================================================
# memento — read-only RFC 7089 Memento + git-versioned data dir (Rung 1.1).
# CJS-only TypeScript; Components.js metadata generated by componentsjs-generator
# (mirrors the shape-validator pattern). Same @solid/community-server symlink
# trick as markdown-rdfa to keep class identity consistent.
# ============================================================================

COPY extensions/memento /community-server/extensions/memento

RUN cd extensions/memento && npm install --ignore-scripts

RUN cd extensions/memento && npm run build

RUN rm -rf /community-server/extensions/memento/node_modules/@solid/community-server && \
    ln -sf /community-server /community-server/extensions/memento/node_modules/@solid/community-server

RUN ln -sf /community-server/extensions/memento /community-server/node_modules/memento

# ============================================================================
# markdown-projection — MarkdownProjectionListener (D58/D71/D72).
# Projects body wikilinks + frontmatter to .meta Turtle on every wiki/*.md write.
# ESM projection pipeline (src/) + CJS wrapper (src-cjs/) same layering as
# markdown-render. Components.js metadata hand-written under dist-cjs/.
# ============================================================================

COPY extensions/markdown-projection /community-server/extensions/markdown-projection

RUN cd extensions/markdown-projection && npm install --ignore-scripts

RUN cd extensions/markdown-projection && npm run build

# Same @solid/community-server symlink trick — class identity must match CSS host
RUN rm -rf /community-server/extensions/markdown-projection/node_modules/@solid/community-server && \
    ln -sf /community-server /community-server/extensions/markdown-projection/node_modules/@solid/community-server

# Symlink into node_modules so Components.js require('@cogitarelink/markdown-projection') resolves.
# npm scoped packages live under node_modules/@cogitarelink/markdown-projection
RUN mkdir -p /community-server/node_modules/@cogitarelink && \
    ln -sf /community-server/extensions/markdown-projection \
       /community-server/node_modules/@cogitarelink/markdown-projection

# ============================================================================
# profile-link — ProfileLinkMetadataWriter for PROF + RFC 6906 (D86).
# Emits Link: rel="profile" headers for resources with dct:conformsTo
# (shapes, profiles, and memory resources with shape constraints).
# ============================================================================

COPY extensions/profile-link /community-server/extensions/profile-link

RUN cd extensions/profile-link && npm install --ignore-scripts

RUN cd extensions/profile-link && npm run build

# Same @solid/community-server symlink trick — class identity must match CSS host
RUN rm -rf /community-server/extensions/profile-link/node_modules/@solid/community-server && \
    ln -sf /community-server /community-server/extensions/profile-link/node_modules/@solid/community-server

# Symlink into node_modules so Components.js require('@cogitarelink/profile-link') resolves
RUN mkdir -p /community-server/node_modules/@cogitarelink && \
    ln -sf /community-server/extensions/profile-link \
       /community-server/node_modules/@cogitarelink/profile-link

# ============================================================================
# wiki-search — full-text grep affordance over /vault/wiki/ markdown bodies
# (Phase 7a, D87). HttpHandler intercepts ?ext=search-grep; MetadataWriter
# adds Link: rel="queryBase" headers. Pure-Node RegExp engine for Phase 1;
# pluggable behind SearchEngine interface (Phase 7b BM25/ripgrep swap).
# ============================================================================

COPY extensions/wiki-search /community-server/extensions/wiki-search

RUN cd extensions/wiki-search && npm install --ignore-scripts

RUN cd extensions/wiki-search && npm run build

RUN rm -rf /community-server/extensions/wiki-search/node_modules/@solid/community-server && \
    ln -sf /community-server /community-server/extensions/wiki-search/node_modules/@solid/community-server

RUN mkdir -p /community-server/node_modules/@cogitarelink && \
    ln -sf /community-server/extensions/wiki-search \
       /community-server/node_modules/@cogitarelink/wiki-search

# ============================================================================
# mem-trigger — MemTriggerListener (Phase C, Memory Structuring Sprint).
# MonitoringStore CDC subscriber that runs cross-resource detectors over
# /vault/wiki/* writes and emits mem:Event activities to /vault/wiki/.events/.
# Unscoped npm name (lsd:module = npmd:mem-trigger), so symlinked at
# node_modules/mem-trigger (not under @cogitarelink/).
# ============================================================================

COPY extensions/mem-trigger /community-server/extensions/mem-trigger

RUN cd extensions/mem-trigger && npm install --ignore-scripts

RUN cd extensions/mem-trigger && npx tsc --skipLibCheck

RUN cd extensions/mem-trigger && npx componentsjs-generator -s src -c dist/components

RUN rm -rf /community-server/extensions/mem-trigger/node_modules/@solid/community-server && \
    ln -sf /community-server /community-server/extensions/mem-trigger/node_modules/@solid/community-server

RUN ln -sf /community-server/extensions/mem-trigger /community-server/node_modules/mem-trigger

# ============================================================================
# Build stamp — baked LATE so earlier layers remain cacheable.
# The ARG default "unknown" means non-Makefile builds still work cleanly.
# Verify with: docker inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' cogitarelink-solid-css-1
# ============================================================================
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA
