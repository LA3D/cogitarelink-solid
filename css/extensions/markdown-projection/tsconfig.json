{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "../..",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esmoduleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../shared/markdown-parsing/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
