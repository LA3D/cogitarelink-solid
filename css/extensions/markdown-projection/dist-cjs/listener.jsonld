{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@cogitarelink/markdown-projection/^0.1.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld"
  ],
  "@id": "npmd:@cogitarelink/markdown-projection",
  "components": [
    {
      "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener",
      "@type": "Class",
      "requireElement": "MarkdownProjectionListener",
      "extends": [
        "css:dist/init/Initializer.jsonld#Initializer"
      ],
      "parameters": [
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_store",
          "range": "css:dist/storage/MonitoringStore.jsonld#MonitoringStore"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_baseUrl",
          "range": "xsd:string"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_dataDir",
          "range": "xsd:string"
        },
        {
          "comment": "IPostProjectionHook \u2014 optional, wildcard range to accept any structurally-compatible class from any extension (NoOpPostProjectionHook by default, MemTriggerPostProjectionHook when mem-trigger overrides).",
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_postProjectionHook"
        },
        {
          "comment": "Pod storage root path under baseUrl (e.g. /vault). Injected so the storage segment lives in one declared config location, not a TS source literal (RQ-Substrate-4 Phase 3 / D107 \u00a74.4). Optional \u2014 the constructor defaults to /vault.",
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_storagePath",
          "range": "xsd:string"
        },
        {
          "comment": "Body-hash stamp predicate. Injected so the deployment IRI lives in config (not a TS source literal); must equal the AdmissionFloorStore stampPredicate so the backstop skip recognises floor-written .meta. Optional \u2014 the constructor defaults to DEFAULT_STAMP_PRED.",
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_stampPredicate",
          "range": "xsd:string"
        },
        {
          "comment": "Memento git repo root (= rootFilePath). Injected so the backstop reads the resource's prior committed body for exact subtraction (PSP T5). Mirrors MementoCommitListener.gitDir. Optional \u2014 empty string disables the git path (degraded pairShadow).",
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_gitDir",
          "range": "xsd:string"
        }
      ],
      "constructorArguments": [
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_store"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_baseUrl"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_dataDir"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_postProjectionHook"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_storagePath"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_stampPredicate"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownProjectionListener_gitDir"
        }
      ]
    },
    {
      "@id": "mpl:dist-cjs/listener.jsonld#NoOpPostProjectionHook",
      "@type": "Class",
      "requireElement": "NoOpPostProjectionHook"
    },
    {
      "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector",
      "@type": "Class",
      "requireElement": "MarkdownBodyProjector",
      "parameters": [
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_baseUrl",
          "range": "xsd:string"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_dataDir",
          "range": "xsd:string"
        },
        {
          "comment": "Pod storage root path under baseUrl (e.g. /vault). Optional \u2014 the constructor defaults to /vault.",
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_storagePath",
          "range": "xsd:string"
        },
        {
          "comment": "IPostProjectionHook \u2014 optional, wildcard range to accept any structurally-compatible class from any extension (NoOpPostProjectionHook by default, MemTriggerPostProjectionHook when mem-trigger overrides). Mirrors MarkdownProjectionListener's hook param exactly.",
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_postProjectionHook"
        }
      ],
      "constructorArguments": [
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_baseUrl"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_dataDir"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_storagePath"
        },
        {
          "@id": "mpl:dist-cjs/listener.jsonld#MarkdownBodyProjector_postProjectionHook"
        }
      ]
    }
  ]
}
