{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/markdown-render/^0.1.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld"
  ],
  "@id": "npmd:markdown-render",
  "components": [
    {
      "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter",
      "@type": "Class",
      "requireElement": "MarkdownRdfaConverter",
      "extends": [
        "css:dist/storage/conversion/BaseTypedRepresentationConverter.jsonld#BaseTypedRepresentationConverter"
      ],
      "comment": "Renders Markdown to semantically-annotated HTML with resolved wikilinks and RDFa attributes, using the unified/remark/rehype pipeline from markdown-render. CJS wrapper that lazy-loads the ESM pipeline via dynamic import.",
      "parameters": [
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter_podBase",
          "range": {
            "@type": "ParameterRangeWildcard"
          },
          "comment": "Pod base URL used by the wikilink resolver to build target hrefs. Optional. Wired to urn:solid-server:default:variable:baseUrl in config (not a literal)."
        },
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter_storagePath",
          "range": "xsd:string",
          "comment": "Pod storage root path under podBase (e.g. /vault). The resolver mints wikilink hrefs under podBase + storagePath + /wiki/... so the href matches the projected .meta edge (R-T2 / D107). Optional — defaults to /vault."
        }
      ],
      "memberFields": [
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter__member_podBase",
          "memberFieldName": "podBase",
          "range": {
            "@type": "ParameterRangeWildcard"
          }
        },
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter__member_storagePath",
          "memberFieldName": "storagePath",
          "range": "xsd:string"
        },
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter__member_constructor",
          "memberFieldName": "constructor"
        },
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter__member_handle",
          "memberFieldName": "handle"
        }
      ],
      "constructorArguments": [
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter_podBase"
        },
        {
          "@id": "mrc:dist-cjs/converter.jsonld#MarkdownRdfaConverter_storagePath"
        }
      ]
    }
  ]
}
