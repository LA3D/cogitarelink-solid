{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/shape-validation-component/^2.0.0/components/context.jsonld"
  ],
  "@graph": [
    {
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ResourceStore_Patching" },
      "overrideParameters": {
        "@type": "PatchingStore",
        "source": { "@id": "urn:shape-validation:default:ResourceStore_Shape" },
        "patchHandler": { "@id": "urn:solid-server:default:PatchHandler" }
      }
    },
    {
      "comment": "Validates resources when parent container has ldp:constrainedBy in its metadata. Also enforces D99 Layer 2 path-based class disjointness via pathConstraints. NOTE: this file is a reference — the active wiring is in solid-config.json's inline ShapeValidationStore declaration.",
      "@id": "urn:shape-validation:default:ResourceStore_Shape",
      "@type": "ShapeValidationStore",
      "identifierStrategy": { "@id": "urn:solid-server:default:IdentifierStrategy" },
      "metadataStrategy": { "@id": "urn:solid-server:default:MetadataStrategy" },
      "converter": { "@id": "urn:solid-server:default:RepresentationConverter" },
      "source": { "@id": "urn:solid-server:default:ResourceStore_Converting" },
      "validator": {
        "@id": "urn:shape-validation:default:ShaclValidator",
        "@type": "ShaclValidator",
        "converter": { "@id": "urn:solid-server:default:RepresentationConverter" },
        "auxiliaryStrategy": { "@id": "urn:solid-server:default:AuxiliaryStrategy" }
      },
      "pathConstraints": [
        {
          "@type": "PathConstraintConfig",
          "pathPrefix": "/vault/wiki/.events/",
          "allowedClasses": ["https://pod.vardeman.me/vault/ontology/mem#Event"],
          "forbiddenClasses": []
        },
        {
          "@type": "PathConstraintConfig",
          "pathPrefix": "/vault/wiki/.operations/",
          "allowedClasses": ["https://www.w3.org/ns/activitystreams#Activity"],
          "forbiddenClasses": []
        },
        {
          "@type": "PathConstraintConfig",
          "pathPrefix": "/vault/wiki/events/",
          "allowedClasses": [],
          "forbiddenClasses": [
            "https://pod.vardeman.me/vault/ontology/mem#Event",
            "https://pod.vardeman.me/vault/ontology/mem#Action"
          ]
        },
        {
          "@type": "PathConstraintConfig",
          "pathPrefix": "/vault/wiki/procedures/",
          "allowedClasses": [],
          "forbiddenClasses": ["https://pod.vardeman.me/vault/ontology/mem#Action"]
        }
      ]
    }
  ]
}
