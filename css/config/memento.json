{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/asynchronous-handlers/^1.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/memento/^0.1.0/components/context.jsonld"
  ],
  "@graph": [
    {
      "comment": "Read-only Memento (RFC 7089) HTTP handler. Sits ahead of LdpHandler in the BaseHttpHandler waterfall; claims GETs with Accept-Datetime / ?ext=timemap / ?version= and falls through (NotImplementedHttpError) otherwise.",
      "@id": "urn:cogitarelink:MementoHttpHandler",
      "@type": "MementoHttpHandler",
      "gitDir": { "@id": "urn:solid-server:default:variable:rootFilePath" },
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" }
    },
    {
      "comment": "Insert MementoHttpHandler immediately before LdpHandler so Memento-shaped requests get claimed before standard LDP processing.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:BaseHttpHandler" },
      "overrideSteps": [{
        "@type": "OverrideListInsertBefore",
        "overrideParameter": { "@id": "css:dist/util/handlers/StatusWaterfallHandler.jsonld#StatusWaterfallHandler_handlers" },
        "overrideTarget": { "@id": "urn:solid-server:default:LdpHandler" },
        "overrideValue": { "@id": "urn:cogitarelink:MementoHttpHandler" }
      }]
    },
    {
      "@id": "urn:cogitarelink:MementoCommitListener",
      "@type": "MementoCommitListener",
      "store": { "@id": "urn:solid-server:default:ResourceStore" },
      "gitDir": { "@id": "urn:solid-server:default:variable:rootFilePath" },
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" }
    },
    {
      "comment": "Per RFC 7089 §4.1.1, the OriginalResource must advertise its TimeMap and TimeGate via Link headers on every response, plus Vary: accept-datetime. This writer runs alongside the default LinkRelMetadataWriter; CSS's addHeader accumulates so both contribute to the final Link header. NOTE: WorkerParallelInitializer override moved to markdown-projection.json (both listeners must be in one place).",
      "@id": "urn:cogitarelink:MementoLinkMetadataWriter",
      "@type": "MementoLinkMetadataWriter",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" }
    },
    {
      "comment": "Insert MementoLinkMetadataWriter after the default LinkRelMetadataWriter so existing Link rels (ldp:constrainedBy etc) get serialized first; we append on top.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:MetadataWriter" },
      "overrideSteps": [{
        "@type": "OverrideListInsertAfter",
        "overrideParameter": { "@id": "ah:dist/ParallelHandler.jsonld#ParallelHandler_handlers" },
        "overrideTarget": { "@id": "urn:solid-server:default:MetadataWriter_LinkRel" },
        "overrideValue": { "@id": "urn:cogitarelink:MementoLinkMetadataWriter" }
      }]
    }
  ]
}
