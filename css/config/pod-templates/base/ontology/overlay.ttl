@prefix overlay: <https://pod.vardeman.me/vault/ontology/overlay#> .
@prefix cap:     <https://pod.vardeman.me/vault/ontology/capability#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dct:     <http://purl.org/dc/terms/> .

overlay:Overlay a rdfs:Class ;
    rdfs:label "Application overlay" ;
    rdfs:comment "An installable bundle of containers, shapes, descriptors, vocabulary, and Type Index entries that adds an application to a Pod." ;
    rdfs:isDefinedBy <> .

overlay:name           a rdf:Property ; rdfs:label "Overlay short name" ; rdfs:isDefinedBy <> .
overlay:version        a rdf:Property ; rdfs:label "Overlay version" ; rdfs:isDefinedBy <> .

overlay:declaresVocabulary a rdf:Property ;
    rdfs:label "Vocabulary declared by this overlay" ;
    rdfs:comment "Object is a blank node with overlay:namespace, overlay:document, overlay:hostedAt." ;
    rdfs:isDefinedBy <> .

overlay:namespace      a rdf:Property ; rdfs:label "Vocabulary namespace IRI" ; rdfs:isDefinedBy <> .
overlay:document       a rdf:Property ; rdfs:label "Vocabulary source document (overlay-local path)" ; rdfs:isDefinedBy <> .
overlay:hostedAt       a rdf:Property ; rdfs:label "Pod-side path where vocabulary will be hosted" ; rdfs:isDefinedBy <> .

overlay:requiresCapability a rdf:Property ;
    rdfs:label "Capability required by this overlay" ;
    rdfs:comment "Object is a blank node with cap:requires (IRI of capability descriptor) and cap:minVersion." ;
    rdfs:isDefinedBy <> .

overlay:optionalCapability a rdf:Property ;
    rdfs:label "Capability optionally consumed by this overlay" ;
    rdfs:comment "If absent, overlay degrades per overlay:degradesTo." ;
    rdfs:isDefinedBy <> .

overlay:degradesTo a rdf:Property ;
    rdfs:label "Human-readable description of degraded behavior" ;
    rdfs:isDefinedBy <> .

overlay:dependsOnOverlay a rdf:Property ;
    rdfs:label "Overlay this depends on being already installed" ;
    rdfs:comment "DEPRECATED: overlay-to-overlay dependencies are replaced by capability-based dependencies (overlay:requiresCapability). CSS returns 405 on PATCH to .well-known/solid, making overlay-install tracking unworkable. Use overlay:requiresCapability against a catalog entry instead." ;
    owl:deprecated true ;
    rdfs:isDefinedBy <> .

overlay:installsContainer    a rdf:Property ; rdfs:label "Pod path of a container this overlay creates" ; rdfs:isDefinedBy <> .
overlay:installsShape        a rdf:Property ; rdfs:label "Pod URL of a SHACL shape file this overlay uploads" ; rdfs:isDefinedBy <> .
overlay:installsAffordance   a rdf:Property ; rdfs:label "Pod URL of an affordance descriptor this overlay uploads" ; rdfs:isDefinedBy <> .
overlay:installsProfile        a rdf:Property ; rdfs:label "Pod URL of a PROF profile descriptor this overlay uploads" ; rdfs:isDefinedBy <> .
overlay:installsRoleScheme     a rdf:Property ; rdfs:label "Pod URL of a SKOS role-concept scheme this overlay publishes" ; rdfs:isDefinedBy <> .
overlay:installsTypeRegistration a rdf:Property ;
    rdfs:label "Type Index registration this overlay adds" ;
    rdfs:comment "Object is a blank node with solid:forClass + solid:instanceContainer." ;
    rdfs:isDefinedBy <> .

overlay:installsTemplate a rdf:Property ;
    rdfs:label "installs template" ;
    rdfs:comment "An overlay installs a template document at the given URI. Templates are RDF skeletons paired with a SHACL shape via tmpl:validatesAgainst; agents fetch them before write operations to front-load structured context and reduce SHACL violation cycles." ;
    rdfs:domain overlay:Overlay ;
    rdfs:range  rdfs:Resource ;
    rdfs:isDefinedBy <> .

overlay:installsContainerMetaPatch a rdf:Property ;
    rdfs:label "installs container meta patch" ;
    rdfs:comment "An overlay installs an N3 Patch to a container's .meta. Used to declare ldp:constrainedBy or other container-level metadata. apply.py iterates this predicate and PATCHes each target container's .meta." ;
    rdfs:domain overlay:Overlay ;
    rdfs:isDefinedBy <> .

overlay:targetContainer a rdf:Property ;
    rdfs:label "target container URL" ;
    rdfs:comment "The URL of the container whose .meta will be patched (used in overlay:installsContainerMetaPatch blank nodes)." ;
    rdfs:isDefinedBy <> .

overlay:metaPatchContent a rdf:Property ;
    rdfs:label "meta patch content path" ;
    rdfs:comment "Relative path (within the overlay directory) to the N3 Patch file for the target container's .meta." ;
    rdfs:isDefinedBy <> .

overlay:providesCapability a rdf:Property ;
    rdfs:label "provides capability" ;
    rdfs:comment "An overlay provides a capability when installed. apply.py iterates this predicate and PUTs each referenced capability descriptor to /vault/meta/capabilities/. Other overlays declare overlay:requiresCapability against the same descriptor IRI. Replaces the deprecated overlay:installedOverlay tracking (CSS 405 on PATCH to .well-known/solid made that mechanism unworkable; capability catalog is the runtime-mutable substitute per D83)." ;
    rdfs:domain overlay:Overlay ;
    rdfs:isDefinedBy <> .

overlay:installedOverlay a rdf:Property ;
    rdfs:label "installed overlay" ;
    rdfs:comment "DEPRECATED: runtime overlay-install tracking via the storage description is unworkable (CSS returns 405 on PATCH to .well-known/solid). Replaced by overlay:providesCapability: overlays publish their capabilities to /vault/meta/capabilities/ at install time, which is a normal LDP container supporting PUT." ;
    owl:deprecated true ;
    rdfs:isDefinedBy <> .
