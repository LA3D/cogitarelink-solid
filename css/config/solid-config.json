{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^8.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/shape-validation-component/^2.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/markdown-render/^0.1.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/memento/^0.1.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@cogitarelink/markdown-projection/^0.1.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@cogitarelink/wiki-search/^0.1.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/mem-trigger/^0.1.0/components/context.jsonld"
  ],
  "import": [
    "./dev-allow-all.json",
    "./pod-templates-override.json",
    "./void-description.json",
    "./memento.json",
    "./markdown-projection.json",
    "./wiki-search.json",
    "./mem-trigger.json"
  ],
  "@graph": [
    {
      "comment": "cogitarelink-solid: CSS v8 alpha + SHACL shape validation via ldp:constrainedBy + custom markdown→HTML converter (markdown-render)"
    },
    {
      "comment": "TODO (Phase 6): serve css/extensions/markdown-render/static/wikilinks.css at /static/wikilinks.css. CSS v8 StaticAssetsHandler or RouterHandler pattern needed. metadata-card extension uses inline <style> instead, so no existing precedent in this codebase. The rendered HTML links to /static/wikilinks.css already (rehype-document css option); without this wiring the browser falls back to unstyled but functional wikilinks."
    },
    {
      "comment": "Replace the default MarkdownToHtmlConverter with our MarkdownRdfaConverter. The Override changes the @type of the existing instance (keeping its @id so the ChainedConverter's converters list still references it) and swaps the templateEngine parameter for our single podBase parameter. Our converter emits a complete HTML document itself — no CSS template wrapping.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:MarkdownToHtmlConverter" },
      "overrideParameters": {
        "@type": "MarkdownRdfaConverter",
        "podBase": "https://pod.vardeman.me"
      }
    },
    {
      "comment": "Add ldp:constrainedBy to the existing LinkRel metadata writer so it appears as a Link header.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:MetadataWriter_LinkRel" },
      "overrideParameters": {
        "@type": "LinkRelMetadataWriter",
        "linkRelMap": [
          {
            "LinkRelMetadataWriter:_linkRelMap_key": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
            "LinkRelMetadataWriter:_linkRelMap_value": "type"
          },
          {
            "LinkRelMetadataWriter:_linkRelMap_key": "http://www.w3.org/ns/ldp#inbox",
            "LinkRelMetadataWriter:_linkRelMap_value": "http://www.w3.org/ns/ldp#inbox"
          },
          {
            "LinkRelMetadataWriter:_linkRelMap_key": "http://www.w3.org/ns/ldp#constrainedBy",
            "LinkRelMetadataWriter:_linkRelMap_value": "http://www.w3.org/ns/ldp#constrainedBy"
          }
        ]
      }
    },
    {
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ResourceStore_Patching" },
      "overrideParameters": {
        "@type": "PatchingStore",
        "source": { "@id": "urn:shape-validation:default:ResourceStore_Shape" },
        "patchHandler": { "@id": "urn:solid-server:default:PatchHandler" }
      }
    },
    {
      "comment": "Validates resources when parent container has ldp:constrainedBy in its metadata.",
      "@id": "urn:shape-validation:default:ResourceStore_Shape",
      "@type": "ShapeValidationStore",
      "identifierStrategy": { "@id": "urn:solid-server:default:IdentifierStrategy" },
      "metadataStrategy": { "@id": "urn:solid-server:default:MetadataStrategy" },
      "converter": { "@id": "urn:solid-server:default:RepresentationConverter" },
      "source": { "@id": "urn:solid-server:default:ResourceStore_Converting" },
      "validator": {
        "@id": "urn:shape-validation:default:ShaclValidator",
        "@type": "ShaclValidator",
        "converter": { "@id": "urn:solid-server:default:RepresentationConverter" },
        "auxiliaryStrategy": { "@id": "urn:solid-server:default:AuxiliaryStrategy" }
      }
    },
    {
      "comment": "ShaclErrorHandler intercepts ShaclValidationError (thrown by ShaclValidator on non-conformance) and returns 422 with Content-Type: text/turtle body containing the sh:ValidationReport. Inserted before ConvertingErrorHandler so agents can self-correct from parseable RDF instead of opaque JSON. Falls through (NotImplementedHttpError) for all other error types.",
      "@id": "urn:shape-validation:default:ShaclErrorHandler",
      "@type": "ShaclErrorHandler"
    },
    {
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:WaterfallErrorHandler" },
      "overrideSteps": [{
        "@type": "OverrideListInsertBefore",
        "overrideParameter": { "@id": "css:dist/util/handlers/StatusWaterfallHandler.jsonld#StatusWaterfallHandler_handlers" },
        "overrideTarget": { "@id": "urn:solid-server:default:ConvertingErrorHandler" },
        "overrideValue": { "@id": "urn:shape-validation:default:ShaclErrorHandler" }
      }]
    }
  ]
}
