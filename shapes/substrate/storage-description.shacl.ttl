@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix pim:   <http://www.w3.org/ns/pim/space#> .
@prefix solid: <http://www.w3.org/ns/solid/terms#> .
@prefix wiki:  <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sub:   <https://pod.vardeman.me/vault/ontology/substrate#> .

<> dct:conformsTo <https://www.w3.org/TR/shacl/> .

# StorageDescriptionShape — the contract the Pod's own .well-known/solid must
# satisfy. The storage description is the L1 discovery entry point (D44): an
# agent dereferences it first, then follows the catalog pointers to learn the
# substrate's capabilities. This shape makes those pointers a checkable
# obligation. Validated by pod-audit with inference="none" (see FOLLOWUPS:
# RDFS entailment would mask a missing pointer by satisfying nodeKind via
# inferred triples). Cross-checks (do the pointed-at IRIs resolve?) are the
# walker's job, not SHACL's — this shape only asserts the pointers are present.
wiki:StorageDescriptionShape
    a sh:NodeShape ;
    rdfs:label "Storage description contract" ;
    rdfs:comment "Governs the Pod's .well-known/solid storage description. Requires the five catalog pointers an arriving agent follows (affordance, type index, JSON-LD context, shape catalog, profile document) plus a conformance declaration. Targets pim:Storage." ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/wiki> ;
    dct:conformsTo <https://www.w3.org/TR/shacl/> ;
    dct:created "2026-05-23"^^xsd:date ;
    dct:creator <https://orcid.org/0000-0003-4091-6059> ;
    sh:targetClass pim:Storage ;
    sh:agentInstruction """This Pod is a hybrid contextualized knowledge graph (Verborgh): each entity has a document view (the markdown body) and a graph view (the .meta triples, queryable via SPARQL) of the same underlying statements. /vault/wiki/ is the wiki-memory profile's document view -- it is NOT a wiki application. Class -> container routing is via the Type Index (solid:publicTypeIndex); that is one view's routing hint, not a privileged hierarchy. This storage description is the front door. An agent arriving cold should GET <.well-known/solid> (Accept: text/turtle), then follow sub:affordanceCatalog to enumerate capabilities, solid:publicTypeIndex for class -> container routing, sub:contextDocument for prefix -> IRI resolution, sub:shapeCatalog for the SHACL governing content, and sub:profileDocument for the wiki-memory L3 profile narrative. Each pointer must resolve (pod-audit HEAD-checks them). If you are extending the substrate with a new catalog, add its pointer here so agents can discover it.""" ;
    sh:property [
        sh:path sub:affordanceCatalog ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Storage description must point at the affordance catalog via sub:affordanceCatalog (D52)."
    ] ;
    sh:property [
        sh:path solid:publicTypeIndex ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Storage description must point at the Type Index via solid:publicTypeIndex (D8) for class -> container routing."
    ] ;
    sh:property [
        sh:path sub:contextDocument ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Storage description must point at the JSON-LD context via sub:contextDocument (D76/D79)."
    ] ;
    sh:property [
        sh:path sub:shapeCatalog ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Storage description must point at the SHACL shape catalog via sub:shapeCatalog (D77/D98)."
    ] ;
    sh:property [
        sh:path sub:profileDocument ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Storage description must point at the wiki-memory L3 profile document via sub:profileDocument (D71/D93)."
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Storage description must declare at least one dct:conformsTo profile."
    ] ;
    # Entry-point guidance: satisfied by EITHER a sub:agentGuide IRI pointer
    # (the StaticStorageDescriber path — it can only emit IRIs) OR a
    # sh:agentInstruction string literal (for future hand-authored descriptions).
    # sub:agentGuide is now emitted via void-description.json, so this
    # sh:or evaluates to true and the requirement is met.
    # DELIBERATE Violation severity (was Warning): entry-point guidance is now
    # MANDATORY — it was advisory only because previously unsatisfiable
    # (StaticStorageDescriber can't emit a literal sh:agentInstruction); now that
    # sub:agentGuide makes it satisfiable, a missing entry-point guide is an ERROR.
    # Source of the agentGuide IRI: css/config/void-description.json (keep in sync).
    sh:or (
        [ sh:property [ sh:path sub:agentGuide ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path sh:agentInstruction ;
                        sh:minCount 1 ;
                        sh:datatype xsd:string ] ]
    ) ;
    sh:message "Storage description must carry either a sub:agentGuide IRI pointer or an sh:agentInstruction literal as an entry-point orientation for arriving agents." .
