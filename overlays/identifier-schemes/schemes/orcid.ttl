@prefix idot:     <http://identifiers.org/idot/> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

<> a foaf:Document ;
   dct:title "ORCID identifier-scheme record" ;
   dct:created "2026-06-05"^^xsd:date ;
   foaf:primaryTopic <https://pod.vardeman.me/id/schemes/#orcid> .

<https://pod.vardeman.me/id/schemes/#orcid>
    a idot:Namespace, skos:Concept, rdfs:Datatype ;
    skos:prefLabel "ORCID"@en ;
    skos:definition "Open Researcher and Contributor Identifier — persistent digital identifier for individual researchers, maintained by ORCID Inc."@en ;
    skos:inScheme <https://pod.vardeman.me/id/schemes/> ;
    skos:exactMatch datacite:orcid ;
    rdfs:seeAlso <https://registry.identifiers.org/registry/orcid> ;
    idot:luiPattern "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ;
    idot:sampleID "0000-0003-4091-6059" .

<#orcid-org> a idot:Resource ;
    dct:title "orcid.org — landing page"@en ;
    idot:urlPattern "https://orcid.org/{$id}" ;
    dcat:servesDataset <https://pod.vardeman.me/id/schemes/#orcid> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dct:type <https://pod.vardeman.me/id/roles#landing-page> .
