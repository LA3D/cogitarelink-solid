@prefix idot:     <http://identifiers.org/idot/> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

<> a foaf:Document ;
   dct:title "DID identifier-scheme record" ;
   dct:created "2026-06-05"^^xsd:date ;
   foaf:primaryTopic <https://pod.vardeman.me/id/schemes/#did> .

<https://pod.vardeman.me/id/schemes/#did>
    a idot:Namespace, skos:Concept, rdfs:Datatype ;
    skos:prefLabel "DID"@en ;
    skos:definition "Decentralized Identifier — a W3C standard identifier for verifiable, self-sovereign digital identity, resolved to a DID document by a method-specific resolver."@en ;
    skos:inScheme <https://pod.vardeman.me/id/schemes/> ;
    dct:conformsTo <https://www.w3.org/TR/did-core/> ;
    rdfs:seeAlso <https://www.w3.org/TR/did-core/> ;
    idot:luiPattern "^did:[a-z0-9]+:[a-zA-Z0-9.\\-_:%]+$" ;
    idot:sampleID "did:web:pod.vardeman.me" .

<#uniresolver> a idot:Resource ;
    dct:title "DIF Universal Resolver (dev instance — no SLA)"@en ;
    idot:urlPattern "https://dev.uniresolver.io/1.0/identifiers/{$id}" ;
    dcat:servesDataset <https://pod.vardeman.me/id/schemes/#did> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/did+ld+json> ;
    dct:conformsTo <https://www.w3.org/TR/did-core/> ;
    dct:type <https://pod.vardeman.me/id/roles#did-document> .
