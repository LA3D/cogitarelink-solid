@prefix wiki: <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<> dct:conformsTo <https://www.w3.org/TR/shacl/> .

wiki:ProcedureShape a sh:NodeShape ;
    sh:targetClass wiki:Procedure ;
    sh:closed false ;
    sh:agentInstruction "Procedural memory. dct:title is the procedure name. The procedure body is in the resource's markdown content — agents read it as instructions. sh:agentInstruction on the resource itself MAY duplicate the body for non-markdown clients. See <https://pod.vardeman.me/vault/wiki/index.md> for the full L3 profile and inter-shape conventions." ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
    ] .
