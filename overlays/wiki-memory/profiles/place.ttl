@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix wiki: <https://pod.vardeman.me/vault/ontology/wiki#> .

<https://pod.vardeman.me/vault/meta/profiles/place>
  a prof:Profile ;
  rdfs:label "Wiki-Memory L3 — Place page profile" ;
  sh:agentInstruction "You are reading the wiki-memory Place document view of this entity. The same entity also has a graph view — its .meta triples (Accept: text/turtle on <this>.meta), queryable via SPARQL for the typed predicates. The governing SHACL shape is at /vault/meta/shapes/place.shacl.ttl (sub:shapeCatalog). The canonical entity node is <#this>. (Future: conneg-by-profile ?_profile= will let you select document vs graph view explicitly.)" ;
  rdfs:comment "Profile for wiki:Place pages. Schema.org Place-based with geo anchor predicates." ;
  dct:publisher <https://orcid.org/0000-0003-4091-6059> ;
  dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
  prof:hasToken "wiki-place"^^xsd:token ;
  prof:isProfileOf <https://pod.vardeman.me/vault/meta/profiles/thing> ;
  prof:isTransitiveProfileOf
    <https://pod.vardeman.me/vault/meta/profiles/thing> ,
    <https://pod.vardeman.me/vault/meta/profiles/page> ,
    <https://solidproject.org/TR/protocol> ;
  prof:hasResource
    <https://pod.vardeman.me/vault/meta/profiles/place#shape> ,
    <https://pod.vardeman.me/vault/meta/profiles/place#context> ,
    <https://pod.vardeman.me/vault/meta/profiles/place#vocab> .

<https://pod.vardeman.me/vault/meta/profiles/place#shape>
  a prof:ResourceDescriptor ;
  rdfs:label "SHACL shape for wiki:Place" ;
  dct:conformsTo <https://www.w3.org/TR/shacl/> ;
  dct:format "text/turtle" ;
  prof:hasRole role:validation ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/shapes/place.shacl.ttl> .

<https://pod.vardeman.me/vault/meta/profiles/place#context>
  a prof:ResourceDescriptor ;
  rdfs:label "JSON-LD context" ;
  dct:format "application/ld+json" ;
  prof:hasRole role:schema ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/context.jsonld> .

<https://pod.vardeman.me/vault/meta/profiles/place#vocab>
  a prof:ResourceDescriptor ;
  rdfs:label "wiki vocabulary" ;
  dct:format "text/turtle" ;
  prof:hasRole role:vocabulary ;
  prof:hasArtifact <https://pod.vardeman.me/vault/ontology/wiki> .
