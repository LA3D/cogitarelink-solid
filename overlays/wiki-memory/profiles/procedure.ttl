@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix wiki: <https://pod.vardeman.me/vault/ontology/wiki#> .

<https://pod.vardeman.me/vault/meta/profiles/procedure>
  a prof:Profile ;
  rdfs:label "Wiki-Memory L3 — HowTo page profile" ;
  rdfs:comment "Profile for schema:HowTo pages (procedural memory: how-tos, workflows, recipes). Governed by wiki:HowToShape (howto.shacl.ttl)." ;
  dct:publisher <https://orcid.org/0000-0003-4091-6059> ;
  dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
  prof:hasToken "wiki-procedure"^^xsd:token ;
  prof:isProfileOf <https://pod.vardeman.me/vault/meta/profiles/page> ;
  prof:isTransitiveProfileOf
    <https://pod.vardeman.me/vault/meta/profiles/page> ,
    <https://solidproject.org/TR/protocol> ;
  prof:hasResource
    <https://pod.vardeman.me/vault/meta/profiles/procedure#shape> ,
    <https://pod.vardeman.me/vault/meta/profiles/procedure#context> ,
    <https://pod.vardeman.me/vault/meta/profiles/procedure#vocab> .

<https://pod.vardeman.me/vault/meta/profiles/procedure#shape>
  a prof:ResourceDescriptor ;
  rdfs:label "SHACL shape for schema:HowTo" ;
  dct:conformsTo <https://www.w3.org/TR/shacl/> ;
  dct:format "text/turtle" ;
  prof:hasRole role:validation ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/shapes/howto.shacl.ttl> .

<https://pod.vardeman.me/vault/meta/profiles/procedure#context>
  a prof:ResourceDescriptor ;
  rdfs:label "JSON-LD context" ;
  dct:format "application/ld+json" ;
  prof:hasRole role:schema ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/context.jsonld> .

<https://pod.vardeman.me/vault/meta/profiles/procedure#vocab>
  a prof:ResourceDescriptor ;
  rdfs:label "wiki vocabulary" ;
  dct:format "text/turtle" ;
  prof:hasRole role:vocabulary ;
  prof:hasArtifact <https://pod.vardeman.me/vault/ontology/wiki> .
