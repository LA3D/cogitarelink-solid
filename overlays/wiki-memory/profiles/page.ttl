@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix wiki: <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wiki/role#> .

<https://pod.vardeman.me/vault/meta/profiles/page>
  a prof:Profile ;
  rdfs:label "Wiki-Memory L3 — Page profile" ;
  rdfs:comment "Root profile for all wiki-memory pages on this Pod. The wiki:Concept, wiki:Source, wiki:Person, wiki:Procedure, and wiki:WorkingNote profiles all profile this one." ;
  dct:publisher <https://orcid.org/0000-0003-4091-6059> ;
  dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
  prof:hasToken "wiki-page"^^xsd:token ;
  prof:isProfileOf <https://solidproject.org/TR/protocol> ;
  prof:hasResource
    <https://pod.vardeman.me/vault/meta/profiles/page#shape> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#context> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#vocab> .

<https://pod.vardeman.me/vault/meta/profiles/page#shape>
  a prof:ResourceDescriptor ;
  rdfs:label "SHACL shape for wiki:Page (base)" ;
  dct:conformsTo <https://www.w3.org/TR/shacl/> ;
  dct:format "text/turtle" ;
  prof:hasRole role:validation ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/shapes/page.shacl.ttl> .

<https://pod.vardeman.me/vault/meta/profiles/page#context>
  a prof:ResourceDescriptor ;
  rdfs:label "JSON-LD context for wiki vocabulary" ;
  dct:format "application/ld+json" ;
  prof:hasRole role:schema ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/context.jsonld> .

<https://pod.vardeman.me/vault/meta/profiles/page#vocab>
  a prof:ResourceDescriptor ;
  rdfs:label "wiki vocabulary (Turtle)" ;
  dct:format "text/turtle" ;
  prof:hasRole role:vocabulary ;
  prof:hasArtifact <https://pod.vardeman.me/vault/ontology/wiki> .
