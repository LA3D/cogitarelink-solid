@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix wiki: <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wikirole#> .

<https://pod.vardeman.me/vault/meta/profiles/page>
  a prof:Profile ;
  rdfs:label "Wiki-Memory L3 — Page profile" ;
  sh:agentInstruction """You are reading the wiki-memory Page DOCUMENT VIEW of this entity. The same entity has a GRAPH VIEW in its .meta description resource. The canonical entity node is <#this>. This is the base profile; concrete types (Concept, Person, Place, Event, Organization, Procedure, WorkingNote, Template) profile this one. The governing SHACL shape is in the shape catalog (sub:shapeCatalog).

View authority:
- DOCUMENT VIEW (body) is authoritative for prose and navigational/locally-authorable links. Author here with PUT/PATCH.
- GRAPH VIEW (.meta) is authoritative for typed edges, governed context (open actions, provenance, staleness), and substrate-derived triples. Body wikilinks are a CONVENIENCE PROJECTION of the graph, not authoritative — do not treat them as the ground truth for typed predicates.
- READ ?_profile=fused when your question concerns this resource's graph: it returns the body plus its authoritative governed graph in one representation. Use this for per-resource graph questions; do NOT SPARQL a single resource's .meta directly.
- SPARQL is for CROSS-RESOURCE aggregate queries (e.g., "all Concepts with skos:broader X") — not per-resource graph access.
- WRITE: author content in the document view; propose graph-global judgment (realignment, staleness, cross-scheme links) to the operations ledger (the container linked by the curation affordance), not by editing the body.
- Floor signposts (no tool required): Link rel="describedby" → the .meta graph; Link rel="...mem#hasOpenAction" → an open curation action; Link rel="profile" → this statement.""" ;
  rdfs:comment "Root profile for all wiki-memory pages on this Pod. The wiki:Concept, wiki:Person, schema:HowTo, wiki:WorkingNote, and place/event/organization profiles all profile this one." ;
  dct:publisher <https://orcid.org/0000-0003-4091-6059> ;
  dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
  prof:hasToken "wiki-page"^^xsd:token ;
  prof:isProfileOf <https://solidproject.org/TR/protocol> ;
  prof:hasResource
    <https://pod.vardeman.me/vault/meta/profiles/page#shape> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#context> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#vocab> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#synthesis> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#mem-vocab> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#operation-log> ,
    <https://pod.vardeman.me/vault/meta/profiles/page#event-stream> .

<https://pod.vardeman.me/vault/meta/profiles/page#shape>
  a prof:ResourceDescriptor ;
  rdfs:label "SHACL shape for wiki:Page (base)" ;
  dct:conformsTo <https://www.w3.org/TR/shacl/> ;
  dct:format "text/turtle" ;
  prof:hasRole role:validation ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/shapes/page.shacl.ttl> .

<https://pod.vardeman.me/vault/meta/profiles/page#context>
  a prof:ResourceDescriptor ;
  rdfs:label "JSON-LD context for wiki vocabulary" ;
  dct:format "application/ld+json" ;
  prof:hasRole role:schema ;
  prof:hasArtifact <https://pod.vardeman.me/vault/meta/context.jsonld> .

<https://pod.vardeman.me/vault/meta/profiles/page#vocab>
  a prof:ResourceDescriptor ;
  rdfs:label "wiki vocabulary (Turtle)" ;
  dct:format "text/turtle" ;
  prof:hasRole role:vocabulary ;
  prof:hasArtifact <https://pod.vardeman.me/vault/ontology/wiki> .

# Added 2026-05-18 — Memory Structuring Sprint Phase A.
# Synthesis-layer ResourceDescriptors. The wikirole: prefix in this file
# is aligned with the wikirole.ttl vocabulary file and the storage description
# (https://pod.vardeman.me/vault/ontology/wikirole#).
<https://pod.vardeman.me/vault/meta/profiles/page#synthesis>
  a prof:ResourceDescriptor ;
  rdfs:label "Wiki-memory L3 synthesis (overview)" ;
  dct:format "text/markdown" ;
  prof:hasRole wikirole:overview ;
  prof:hasArtifact <https://pod.vardeman.me/vault/wiki/index.md> .

<https://pod.vardeman.me/vault/meta/profiles/page#mem-vocab>
  a prof:ResourceDescriptor ;
  rdfs:label "mem: memory operation/event/announcement vocabulary" ;
  dct:format "text/turtle" ;
  prof:hasRole wikirole:operation-vocabulary ;
  prof:hasArtifact <https://pod.vardeman.me/vault/ontology/mem> .

<https://pod.vardeman.me/vault/meta/profiles/page#operation-log>
  a prof:ResourceDescriptor ;
  rdfs:label "Agent operation log" ;
  prof:hasRole wikirole:operation-log ;
  prof:hasArtifact <https://pod.vardeman.me/vault/wiki/.operations/> .

<https://pod.vardeman.me/vault/meta/profiles/page#event-stream>
  a prof:ResourceDescriptor ;
  rdfs:label "Substrate event stream" ;
  prof:hasRole wikirole:event-stream ;
  prof:hasArtifact <https://pod.vardeman.me/vault/wiki/.events/> .
