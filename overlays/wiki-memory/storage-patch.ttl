@prefix solid:   <http://www.w3.org/ns/solid/terms#> .
@prefix wiki:    <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix void:    <http://rdfs.org/ns/void#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cito:    <http://purl.org/spar/cito/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix overlay: <https://pod.vardeman.me/vault/ontology/overlay#> .

# NOTE (2026-05-24): this patch targets the storage description, but CSS returns
# 405 on storage-description PATCH (GET-only) — so these inserts do NOT reach
# /vault/.well-known/solid. The static css/config/void-description.json is the
# only source that surfaces there. This overlay's inserts land on /vault/.meta
# (fallback) and are largely inert for storage-description discovery. Kept for
# the .meta fallback; the authoritative storage-description content is static.

<> a solid:InsertDeletePatch ;
   solid:inserts {
       <../>
           dct:conformsTo wiki:WikiMemoryProfile ;
           void:vocabulary <https://pod.vardeman.me/vault/ontology/wiki#> ,
                          <http://purl.org/spar/cito/> ,
                          <http://xmlns.com/foaf/0.1/> ;
           rdfs:seeAlso <../wiki/concepts/> ,
                       <../wiki/people/> ,
                       <../wiki/places/> ,
                       <../wiki/events/> ,
                       <../wiki/organizations/> ,
                       <../wiki/procedures/> ,
                       <../wiki/working/> .
   } .
