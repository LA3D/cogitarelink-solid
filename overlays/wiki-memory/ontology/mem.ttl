@prefix mem:    <https://pod.vardeman.me/vault/ontology/mem#> .
@prefix sub:    <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix as:     <https://www.w3.org/ns/activitystreams#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix interop: <http://www.w3.org/ns/solid/interop#> .

<https://pod.vardeman.me/vault/ontology/mem>
    a owl:Ontology ;
    rdfs:label "Wiki-memory L3 memory operation + event vocabulary" ;
    rdfs:comment "Two top-level categories: mem:Action (agent-initiated LDP write sequences, recorded via prov:wasGeneratedBy and announced via COAR Notify) and mem:Event (substrate-emitted analysis signals, fanned out via Solid Notifications from /vault/wiki/.events/). Subclasses inherit from AS2 / schema.org / PROV-O parents where the semantics align, so an LLM can ground each verb in its pre-training." ;
    dct:conformsTo <https://www.w3.org/ns/activitystreams> ,
                   <http://www.w3.org/ns/prov-o> ;
    rdfs:seeAlso <https://pod.vardeman.me/vault/wiki/index.md> .

# Wiki-memory L3 memory operation + event vocabulary.
# See <https://pod.vardeman.me/vault/wiki/index.md> for the full L3 profile
# and usage context.
#
# Two top-level categories:
#
#   mem:Action  — categories of agent action on memory. Performed as direct
#                 LDP CRUD sequences (Model B; LDN is not the primary write
#                 API). The action's type is recorded in the resulting
#                 resource's .meta via prov:wasGeneratedBy. After completing
#                 an action, the agent posts an as:Announce activity to
#                 /vault/wiki/.operations/ multi-typed with the same Action
#                 class (COAR Notify pattern); no separate past-tense class
#                 is needed.
#
#   mem:Event   — substrate-emitted analysis signals (subclass of
#                 as:Activity). Arrive in subscriber inboxes via Solid
#                 Notifications fan-out from /vault/wiki/.events/.
#
# Proto-knowledge grounding (LLMs have seen these in pre-training):
# each subclass inherits from an AS2 / schema.org / PROV-O parent where
# the semantics align. Substrate-internal signals without a clean
# proto-match stay under their top-level only.

# ============================================================
# Top-level classes
# ============================================================

mem:Action
    a owl:Class ;
    rdfs:label "Memory action" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "A category of agent action on wiki-memory L3. Performed as a sequence of standard LDP operations, not transmitted as a message. The action is recorded canonically on the as:Announce activity the agent posts to /vault/wiki/.operations/ (multi-typed with the subclass IRI; as:object names the affected resource). The resource's own .meta does NOT carry the operation — query the .operations/ log (e.g. via the memory-history affordance) to reconstruct a resource's genesis/history. Subclasses enumerate the actions the substrate supports; most also subclass an AS2 or schema.org verb the LLM already knows from pre-training." ;
    skos:scopeNote "Abstract class; never used as rdf:type directly. Use a concrete subclass (mem:CrystallizeAction, mem:SupersedeAction, mem:MergeAction, mem:DemoteAction, mem:ArchiveAction, mem:LinkAction). CANONICAL announcement form (the source of truth for operation provenance): a resource PUT to /vault/wiki/.operations/ whose own subject <> is multi-typed `a as:Announce, mem:<Subclass>, prov:Activity`, carrying `as:object <target>` (REQUIRED — the resource the operation produced or rewrote), `as:actor <webid>`, and `as:published`^^xsd:dateTime. The resource's own .meta does NOT carry the operation provenance: it is canonical in the .operations/ log (reconstruct a resource's history by querying the log for as:object = <resource>, e.g. via the memory-history affordance). Agents do NOT PATCH prov:wasGeneratedBy onto the resource — the substrate governs that predicate and the log is the source of truth. n-ary operations put sources/partners on prov:wasDerivedFrom, never as:object." ;
    rdfs:seeAlso </vault/meta/affordances/> .

mem:Event
    a owl:Class ;
    rdfs:subClassOf as:Activity ;
    rdfs:label "Substrate analysis event" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "An event emitted by the wiki-memory substrate from cross-resource analysis or scheduled inspection. Subclass of as:Activity (Events ARE inbox messages). Arrives in agents' subscriber inboxes via Solid Notifications fan-out from /vault/wiki/.events/." ;
    skos:scopeNote "Emitted ONLY by the MemTriggerListener substrate component, never by agents. Agents READ events from a subscriber inbox they registered against /vault/wiki/.events/ via Solid Notifications. Do NOT POST an mem:Event subclass; that would be a category error — the substrate owns event production." ;
    rdfs:seeAlso </vault/wiki/.events/> .

# ============================================================
# Action subclasses
# ============================================================
# Each subclasses mem:Action and (where a proto-aligned verb exists)
# an AS2 / schema.org parent. Dereference each class to see the parents.

mem:CrystallizeAction
    a owl:Class ;
    rdfs:subClassOf mem:Action , as:Move ;
    rdfs:label "Crystallize" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Promote a working note from /vault/wiki/working/ to its class-appropriate durable container, per Type Index class→container routing. Validates against the destination class's SHACL shape at PUT time. Subclass of as:Move (move object from origin to target)." ;
    skos:scopeNote "Used as an rdf:type on the as:Announce activity posted to /vault/wiki/.operations/ (the canonical operation record). NOT used as a top-level rdf:type on the durable resource itself — the durable resource is a wiki:Concept (or other wiki:Resource subclass), not the action that produced it — and the operation is NOT recorded on the durable resource's .meta (see mem:Action: provenance is canonical in the .operations/ log)." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/.operations/<id>> (the canonical operation record):
        <> a as:Announce , mem:CrystallizeAction , prov:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/foo.md> ;
           as:actor <https://orcid.org/0000-0003-4091-6059> ;
           prov:used <https://pod.vardeman.me/vault/wiki/working/foo.md> ;
           as:published "2026-05-18T10:00:00Z"^^xsd:dateTime .
        # The durable resource's own .meta carries only prov:wasDerivedFrom <working-source>
        # (agent-authored, ungoverned); it does NOT carry prov:wasGeneratedBy.
    """ ;
    rdfs:seeAlso </vault/meta/affordances/crystallize> .

mem:SupersedeAction
    a owl:Class ;
    rdfs:subClassOf mem:Action , schema:ReplaceAction ;
    rdfs:label "Supersede" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Replace an existing durable resource with a refined version. Prior version captured by Memento; supersession recorded via prov:wasRevisionOf in the updated resource's .meta. Subclass of schema:ReplaceAction (replace one thing with another)." ;
    skos:scopeNote "Use when a durable resource's content is being substantively rewritten while keeping the same identity (URL). For full delete-and-replace at a new URL, use mem:ArchiveAction on the old + mem:CrystallizeAction for the new. Do NOT use SupersedeAction for small edits — those are PATCH operations that don't change identity and don't need a memory action." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/.operations/<id>> (the canonical operation record):
        <> a as:Announce , mem:SupersedeAction , prov:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/foo.md> ;
           as:actor <https://orcid.org/0000-0003-4091-6059> ;
           as:published "2026-05-18T11:00:00Z"^^xsd:dateTime .
        # The resource's own .meta carries prov:wasRevisionOf
        # <https://pod.vardeman.me/vault/wiki/concepts/foo.md?version=2026-05-17T10:00:00Z>
        # (agent-authored, ungoverned); it does NOT carry prov:wasGeneratedBy.
    """ ;
    rdfs:seeAlso </vault/meta/affordances/supersede> .

mem:MergeAction
    a owl:Class ;
    rdfs:subClassOf mem:Action ;
    rdfs:label "Merge" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Combine N durable resources into one. The merged resource's .meta carries prov:wasDerivedFrom for each input; inputs are deleted (typically via mem:ArchiveAction tombstones). No clean AS2 / schema.org parent — multi-source consolidation is substrate-specific." ;
    skos:scopeNote "Use when two or more durable resources should become one canonical resource (e.g., duplicate concepts identified by mem:ConsolidationSuggested). Provenance chain via multiple prov:wasDerivedFrom edges. NOT used for refinement-in-place (that's mem:SupersedeAction) or for adding a new edge between existing resources (mem:LinkAction)." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/.operations/<id>> (the canonical operation record):
        <> a as:Announce , mem:MergeAction , prov:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/canonical.md> ;
           as:actor <https://orcid.org/0000-0003-4091-6059> ;
           prov:wasDerivedFrom <https://pod.vardeman.me/vault/wiki/concepts/duplicate-a.md> ,
                               <https://pod.vardeman.me/vault/wiki/concepts/duplicate-b.md> ;
           as:published "2026-05-18T12:00:00Z"^^xsd:dateTime .
        # as:object names the produced (canonical) resource; the inputs go on
        # prov:wasDerivedFrom, never on as:object.
    """ ;
    rdfs:seeAlso </vault/meta/affordances/merge> .

mem:DemoteAction
    a owl:Class ;
    rdfs:subClassOf mem:Action , as:Undo ;
    rdfs:label "Demote" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Move a durable resource back to working memory for reconsideration. The prior durable version is captured by Memento. Subclass of as:Undo (logically undoes the prior Crystallize)." ;
    skos:scopeNote "Use when a durable resource turns out to be premature — its claims are unsettled or its shape conformance has decayed. The resource moves back to /vault/wiki/working/ under the permissive working shape. NOT used for archival (use mem:ArchiveAction); demote is recoverable, archive is terminal." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/.operations/<id>> (the canonical operation record):
        <> a as:Announce , mem:DemoteAction , prov:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/working/foo.md> ;
           as:actor <https://orcid.org/0000-0003-4091-6059> ;
           prov:used <https://pod.vardeman.me/vault/wiki/concepts/foo.md> ;
           as:published "2026-05-18T12:30:00Z"^^xsd:dateTime .
        # The working resource's own .meta carries prov:wasDerivedFrom <prior-durable-memento>
        # (agent-authored, ungoverned); it does NOT carry prov:wasGeneratedBy.
    """ ;
    rdfs:seeAlso </vault/meta/affordances/demote> .

mem:ArchiveAction
    a owl:Class ;
    rdfs:subClassOf mem:Action , as:Delete ;
    rdfs:label "Archive" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Soft-delete a durable resource via tombstone (per D64). The resource is retained at its URL but marked archived; the archived resource declares 'a as:Tombstone' in its .meta. Subclass of as:Delete (AS2's standard delete verb that produces a Tombstone)." ;
    skos:scopeNote "Use when a resource is no longer canonical (superseded by a merge target, content invalidated, content moved to a new identity). Memento captures the pre-archive state. Do NOT hard-DELETE durable resources — archive preserves audit trail and lets backlinks resolve to a tombstone rather than 404." ;
    skos:example """
        # In the archived resource's own .meta (<https://pod.vardeman.me/vault/wiki/concepts/old.md.meta>):
        <> a as:Tombstone .          # agent-PATCHed; the only triple the resource carries for this op
        # In <https://pod.vardeman.me/vault/wiki/.operations/<id>> (the canonical operation record):
        <> a as:Announce , mem:ArchiveAction , prov:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/old.md> ;
           as:actor <https://orcid.org/0000-0003-4091-6059> ;
           as:published "2026-05-18T12:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/archive> .

mem:LinkAction
    a owl:Class ;
    rdfs:subClassOf mem:Action , as:Add ;
    rdfs:label "Link" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Add a typed cross-reference edge to a resource's .meta. The predicate must be one of the substrate-governed edges per the relevant shape's sub:governs list (D81 predicate-level governance), or an agent-extensible predicate outside that list. Subclass of as:Add (add object to a collection of references)." ;
    skos:scopeNote "Use when introducing a typed edge (skos:broader, wiki:extends, cito:cites, etc.) between two resources. For substrate-governed predicates, prefer editing the body markdown wikilink and letting MarkdownProjectionListener project it into .meta; explicit PATCH is for edges outside the body-projection scope. NOT used for whole-resource creation (mem:CrystallizeAction) or whole-resource replacement (mem:SupersedeAction)." ;
    skos:example """
        # In the subject resource's own .meta (<https://pod.vardeman.me/vault/wiki/concepts/foo.md.meta>, via N3 Patch):
        <> skos:broader <https://pod.vardeman.me/vault/wiki/concepts/bar.md> .   # the typed edge
        # In <https://pod.vardeman.me/vault/wiki/.operations/<id>> (the canonical operation record):
        <> a as:Announce , mem:LinkAction , prov:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/foo.md> ;
           as:actor <https://orcid.org/0000-0003-4091-6059> ;
           as:published "2026-05-18T13:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/link> .

# ============================================================
# Event subclasses
# ============================================================

mem:UnprocessableWrite
    a owl:Class ;
    rdfs:subClassOf mem:Event , as:Reject ;
    rdfs:label "Unprocessable write" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "A SHACL-validated write was rejected by the substrate. Carries the sh:ValidationReport as as:context, the rejected request target as as:object, and the writer's WebID as as:to (so the validation feedback returns to the writer). Subclass of as:Reject — COAR Notify uses Reject for the same failure-feedback pattern." ;
    skos:scopeNote "Emitted ONLY by the substrate (shape-validator extension) in response to a 422 PUT/PATCH. Agents subscribe to this event class via a Solid Notifications subscription on /vault/wiki/.events/ to learn about their own rejected writes asynchronously (the immediate HTTP 422 response is the primary signal; the event is the audit-trail record). Do NOT post mem:UnprocessableWrite — that's a substrate-only emission." ;
    skos:example """
        # In an inbox notification body served from /vault/wiki/.events/<id>:
        <> a mem:UnprocessableWrite , as:Reject , as:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/foo.md> ;
           as:to <https://orcid.org/0000-0003-4091-6059> ;
           as:context [ a sh:ValidationReport ;
                        sh:conforms false ;
                        sh:result [ sh:resultPath dct:title ;
                                    sh:resultMessage "title required" ] ] ;
           as:published "2026-05-18T13:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/wiki/.events/> .

mem:ContradictionDetected
    a owl:Class ;
    rdfs:subClassOf mem:Event , as:Flag ;
    rdfs:label "Contradiction detected" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Two resources express conflicting typed-edge claims (e.g., A wiki:supports B and A wiki:criticizes B). v1 detection is limited to a hand-picked list of contradicting predicate pairs. Subclass of as:Flag (the substrate flags content as needing attention)." ;
    skos:scopeNote "Emitted only by the substrate's contradiction-detection pass over .meta triples. Agents read these from the subscriber inbox and may respond with a curative mem:LinkAction (adding wiki:criticizes / wiki:supersedes) or a mem:MergeAction. Do NOT emit this from agent code; agents instead post a curative action of their own choosing." ;
    skos:example """
        # In an inbox notification body served from /vault/wiki/.events/<id>:
        <> a mem:ContradictionDetected , as:Flag , as:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/a.md> ,
                     <https://pod.vardeman.me/vault/wiki/concepts/b.md> ;
           as:summary "Both wiki:supports and wiki:criticizes assert A vs B." ;
           as:published "2026-05-18T14:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/wiki/.events/> .

mem:ConsolidationSuggested
    a owl:Class ;
    rdfs:subClassOf mem:Event , as:Offer ;
    rdfs:label "Consolidation suggested" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Multiple resources cluster around a topic without a curated hub page. v1 may be log-only (no automatic emission) pending observation of clustering signals. Subclass of as:Offer — the substrate offers to consolidate; the agent may Accept or Reject in response." ;
    skos:scopeNote "Emitted only by substrate clustering analysis. An agent receiving this should consider mem:MergeAction (merge duplicates), mem:LinkAction (add skos:broader edges into a new hub), or no-op (ignore the suggestion). Do NOT emit from agent code." ;
    skos:example """
        # In an inbox notification body served from /vault/wiki/.events/<id>:
        <> a mem:ConsolidationSuggested , as:Offer , as:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/topic-a.md> ,
                     <https://pod.vardeman.me/vault/wiki/concepts/topic-a-variant.md> ,
                     <https://pod.vardeman.me/vault/wiki/concepts/topic-a-related.md> ;
           as:summary "Three pages cluster on topic; consider hub or merge." ;
           as:published "2026-05-18T15:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/wiki/.events/> .

mem:BoundExceeded
    a owl:Class ;
    rdfs:subClassOf mem:Event ;
    rdfs:label "Bound exceeded" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "A container's ldp:contains count crossed the substrate's branching bound (default 12, per xMemory Fano analysis). Emitted at most once per container per 24h to avoid flapping. No AS2 / schema.org parent — invariant-violated signals are substrate-specific." ;
    skos:scopeNote "Emitted only by substrate's bounded-branching check. An agent receiving this should consider mem:LinkAction to add a hub MOC under the over-broad container, or mem:ArchiveAction to retire stale entries. Do NOT emit from agent code." ;
    skos:example """
        # In an inbox notification body served from /vault/wiki/.events/<id>:
        <> a mem:BoundExceeded , as:Activity ;
           as:object <https://pod.vardeman.me/vault/wiki/concepts/> ;
           as:summary "ldp:contains count = 18 exceeds bound of 12." ;
           as:published "2026-05-18T16:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/wiki/.events/> .

mem:ReflectionDue
    a owl:Class ;
    rdfs:subClassOf mem:Event ;
    rdfs:label "Reflection due" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Time-based signal that periodic reflection (lint, contradiction check, hub maintenance) is overdue. Emitted at a configurable interval (default 24h). No AS2 / schema.org parent — scheduling signals are substrate-internal." ;
    skos:scopeNote "Emitted by substrate scheduler. Agents subscribing may use it as a trigger for housekeeping work (running consolidation queries, archiving stale working notes, refreshing derived views). Do NOT emit from agent code; agents schedule their own activity through their own clock, not through Pod events." ;
    skos:example """
        # In an inbox notification body served from /vault/wiki/.events/<id>:
        <> a mem:ReflectionDue , as:Activity ;
           as:summary "24h reflection interval elapsed." ;
           as:published "2026-05-18T17:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/wiki/.events/> .

mem:OODQuerySignal
    a owl:Class ;
    rdfs:subClassOf mem:Event ;
    rdfs:label "Out-of-domain query signal" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "A wiki-search query returned zero or low-quality results, suggesting the substrate lacks coverage of the user's topic. 'OOD' is the standard ML / agentic-memory acronym for out-of-distribution / out-of-domain. v1 may be log-only pending observation of query data. No AS2 / schema.org parent." ;
    skos:scopeNote "Emitted by the wiki-search affordance when its result set falls below a quality threshold. An agent receiving this should consider mem:CrystallizeAction to add new content covering the gap, or report the gap to the human user. Do NOT emit from agent code; the substrate owns the signal because it observes the query+result pair." ;
    skos:example """
        # In an inbox notification body served from /vault/wiki/.events/<id>:
        <> a mem:OODQuerySignal , as:Activity ;
           as:summary "Query 'quantum cryptanalysis' returned 0 results." ;
           as:published "2026-05-18T18:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/wiki/.events/> .

# ============================================================
# Staleness detection + realignment (added 2026-05-23)
# ============================================================
# The substrate's own self-description (storage description, affordance
# descriptors, skill bodies, prose summaries) is wiki-memory L3 content and
# drifts as the design evolves: a pointer keeps its old target after the
# target moved, renamed, or was superseded. Detection is a mem:Event;
# realignment is a mem:Action. The two accumulate in /vault/wiki/.events/
# and /vault/wiki/.operations/ — the start of a memory-evolution context
# graph queryable over time, with Memento as the version axis.
# Reference trace: the 2026-05-23 D77→D98 cleanup (the worked example in
# the "Stale-Memory Discovery and Realignment" method-note).

mem:StalenessDetected
    a owl:Class ;
    rdfs:subClassOf mem:Event , as:Flag ;
    rdfs:label "Staleness detected" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "A reference no longer resolves against current truth: a path/IRI 404s (dangling), a target moved or was renamed, a superseding decision retired the referent, or a scalar/prose claim diverged from the deployed substrate. Carries the stale reference as as:object and a mem:stalenessClass classification. Subclass of as:Flag (the substrate flags content as needing attention) — same pattern as mem:ContradictionDetected." ;
    skos:scopeNote "Emitted by the substrate audit/walker pass over its own self-description and over content .meta. An agent receiving this responds with a curative mem:RealignAction (when current truth is recoverable) or, when the conflict is irreconcilable, leaves it for mem:ContradictionDetected → human escalation. Do NOT emit from agent code; the auditor owns detection. CAUTION: before flagging a scalar/count claim, dereference the canonical decision — the reconciliation may already be written there (the 8-vs-11 false positive of 2026-05-23)." ;
    skos:example """
        # In an inbox notification body served from /vault/wiki/.events/<id>:
        <> a mem:StalenessDetected , as:Flag , as:Activity ;
           as:object <https://pod.vardeman.me/vault/.well-known/solid> ;
           mem:stalenessClass mem:DanglingReference ;
           as:summary "rdfs:seeAlso </vault/wiki/pages/> returns 404; container renamed to concepts/ (D98)." ;
           as:published "2026-05-23T10:00:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/wiki/.events/> .

mem:RealignAction
    a owl:Class ;
    rdfs:subClassOf mem:Action , schema:ReplaceAction ;
    rdfs:label "Realign" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Replace a stale reference with the current one, resolving prose/pointer drift toward the authoritative source. The corrected resource is the as:object; the source resolved against is prov:used (encoding the ground-truth precedence: deployed Pod > decisions log > prose summaries); the stale prior is prov:wasDerivedFrom; the classification is mem:stalenessClass; and the agentic reasoning is carried as mem:rationale (required — a realignment without recorded reasoning is not auditable). Subclass of schema:ReplaceAction, like mem:SupersedeAction." ;
    skos:scopeNote "Use when current truth is recoverable and one side is authoritative (prose lags reality → realign the prose; reality lags a decision → repair toward the decision). Do NOT use for irreconcilable conflicts between two equally-authoritative sources — those go to a human via mem:ContradictionDetected + LDN. Two-stage commit (D73): curator proposals land in /vault/wiki/working/curator-proposals/ first; crystallization to the affected resource needs human or higher-trust review." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/.operations/<id>> (the resource's own subject):
        <> a as:Announce , mem:RealignAction , prov:Activity ;
           as:object <https://pod.vardeman.me/vault/meta/affordances/wiki-search-grep.ttl> ;
           as:actor <https://orcid.org/0000-0003-4091-6059> ;
           prov:used <https://pod.vardeman.me/vault/ontology/mem#> ;
           mem:stalenessClass mem:SupersededConcept ;
           mem:rationale "skill descriptions asserted '5-shape catalog (D77)'; D98 supersedes D77 with 8 NodeShapes / 11 files. Realigned three skill descriptions to D98." ;
           as:published "2026-05-23T10:05:00Z"^^xsd:dateTime .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/> .

mem:rationale
    a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    rdfs:isDefinedBy <> ;
    rdfs:domain prov:Activity ;
    rdfs:comment "The agent's reasoning for a memory mutation, in natural language: what was observed, what it was resolved against, why this repair (or withdrawal). Required on mem:RealignAction activities so a human or later agent can reconstruct why a memory changed. This is the provenance-of-reasoning that complements PROV's provenance-of-data." .

# Staleness classification — a controlled set of detection outcomes.
# Maps to who handles each: dangling is mechanical (auditor / HTTP HEAD);
# the rest need the agentic curator. FalsePositive records a withdrawn flag
# (resolved against the canonical source, found correct) — kept so the
# context graph captures non-repairs too, not only repairs.

mem:StalenessClass
    a owl:Class ;
    rdfs:label "Staleness class" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "The kind of staleness a reference exhibits. Range of mem:stalenessClass." .

mem:stalenessClass
    a owl:ObjectProperty ;
    rdfs:label "staleness class" ;
    rdfs:isDefinedBy <> ;
    rdfs:domain [ owl:unionOf ( mem:StalenessDetected mem:RealignAction ) ] ;
    rdfs:range mem:StalenessClass ;
    rdfs:comment "Classifies a detected or repaired staleness. Drives the repair playbook: mem:DanglingReference is mechanically detectable (auditor); the rest need agentic resolution." .

mem:DanglingReference   a mem:StalenessClass , skos:Concept ; rdfs:label "Dangling reference" ;
    rdfs:comment "A path/IRI that no longer resolves (404 / file absent). Mechanically detectable by HTTP HEAD or path-exists." .
mem:MovedTarget         a mem:StalenessClass , skos:Concept ; rdfs:label "Moved target" ;
    rdfs:comment "The referent still exists but at a new location; resolution fails until the reference is located by content." .
mem:SupersededConcept   a mem:StalenessClass , skos:Concept ; rdfs:label "Superseded concept" ;
    rdfs:comment "A decision/concept the reference names was retired by a superseding decision (e.g. D77 → D98)." .
mem:ScalarDrift         a mem:StalenessClass , skos:Concept ; rdfs:label "Scalar drift" ;
    rdfs:comment "A count/number claim diverged from ground truth (e.g. '5-shape' vs the deployed catalog). Verify the referent before flagging — granularity differences masquerade as drift." .
mem:ProseDrift          a mem:StalenessClass , skos:Concept ; rdfs:label "Prose drift" ;
    rdfs:comment "A description still reads as current but narrates an earlier design. No broken link; detected only by semantic comparison against current truth." .
mem:CodeDrift           a mem:StalenessClass , skos:Concept ; rdfs:label "Code drift" ;
    rdfs:comment "Executable code (test, script, config) references substrate that a decision renamed/removed (e.g. a test loading source.shacl.ttl post-D98). Repair direction is code → decision, not prose → reality." .
mem:FalsePositive       a mem:StalenessClass , skos:Concept ; rdfs:label "False positive" ;
    rdfs:comment "A flagged reference resolved as correct against the canonical source; the flag is withdrawn. Recorded so the context graph captures non-repairs, and so the false-positive guard is itself auditable." .

# ============================================================
# D112 — curation protocol terms (added 2026-06-05)
# ============================================================
# The curation loop (D112 sub-C) operates at Tier-2 (Karpathy Lint).
# Three classes of artefact:
#   mem:hasOpenAction   — server-derived back-pointer from a resource to its
#                         pending curation activity in .operations/ (Link header)
#   mem:CurationNeed    — a declared check an application asks the curator to run
#   mem:applyClass / mem:ledger — routing metadata on a CurationNeed
# Two apply-class lanes (DeriveClass / JudgmentClass) mirror the floor/loop rule
# (derive-inferable / floor-locally-authorable / loop-graph-global, D109).
# Two new staleness classes extend the existing StalenessClass scheme:
#   mem:ProviderDrift   — D111 probe-caught: provider no longer resolves as declared
#   mem:Materialization — not staleness but a derivable projection gap

mem:hasOpenAction
    a rdf:Property ;
    rdfs:label "has open action" ;
    rdfs:comment "Target resource → a pending (schema:PotentialActionStatus) curation activity in a .operations/ ledger. SERVER-DERIVED only: maintained by OperationsIndexListener from the ledger state; agents never author it (the ldp:contains precedent). Surfaced on GET as a Link header (rel = this property's IRI)." ;
    rdfs:range prov:Activity .

mem:CurationNeed
    a rdfs:Class ;
    rdfs:label "Curation need" ;
    rdfs:comment "One declared Tier-2 check an application asks the curator role to run over its data registration. The check procedure rides on sh:agentInstruction (the on-Pod source of truth, D103); the intended lane on mem:applyClass; the ledger to file into on mem:ledger. Declared at deploy time — never invented at run time (D112 §7)." .

mem:hasCurationNeed
    a rdf:Property ;
    rdfs:label "has curation need" ;
    rdfs:domain interop:Application ;
    rdfs:range mem:CurationNeed ;
    rdfs:comment "An interop:Application declares the curation checks its data registration needs (policy-as-data, D112 §4)." .

mem:applyClass
    a rdf:Property ;
    rdfs:label "apply class" ;
    rdfs:domain mem:CurationNeed ;
    rdfs:comment "The need's INTENDED lane (D112 §7). v1 behavior is propose-only for both lanes; graduation of a DeriveClass need to auto-apply is earned by a maturity score over its trace history (clean-trace rate, reversal rate, plan-version stability), never granted by design." .

mem:ledger
    a rdf:Property ;
    rdfs:label "ledger" ;
    rdfs:domain mem:CurationNeed ;
    rdfs:comment "The .operations/ container proposals for this need are filed into (one activity per resource, <>-subject, LDN sender pattern)." .

mem:DeriveClass         a skos:Concept ; rdfs:label "derive class" ;
    skos:definition "Recomputable from the graph, idempotent, destroys no information." .
mem:JudgmentClass       a skos:Concept ; rdfs:label "judgment class" ;
    skos:definition "Requires judgment, destroys or reinterprets information, or asserts facts about the world." .

mem:ProviderDrift       a mem:StalenessClass , skos:Concept ; rdfs:label "Provider drift" ;
    skos:definition "A declared identifier-resolution provider no longer resolves as declared (sampleID × urlPattern × mediaType mismatch). Evidence of the failing HTTP transaction goes in mem:rationale." .
mem:Materialization     a mem:StalenessClass , skos:Concept ; rdfs:label "Materialization" ;
    skos:definition "Not staleness: a derivable projection the graph should carry but does not yet (e.g. the schema:PropertyValue projection on a scheme record). The proposal body contains the exact triples to add, so the resolving act is mechanical." .
