@prefix dct:      <http://purl.org/dc/terms/> .
@prefix prof:     <http://www.w3.org/ns/dx/prof/> .
@prefix wiki:     <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sub:      <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix cap:      <https://pod.vardeman.me/vault/ontology/capability#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wikirole#> .

<> a sub:VersionAffordance ,
       prof:ResourceDescriptor ;
   dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
   prof:hasRole wikirole:version-affordance ;
   rdfs:label "RFC 7089 Memento time-travel" ;
   sub:requiresCapability <https://pod.vardeman.me/vault/meta/capabilities/time-travel.ttl> ;
   wiki:conformsTo <http://www.rfc-editor.org/rfc/rfc7089.txt> ;
   sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> ;
   sh:agentInstruction "Append ?ext=timemap to any resource URL for its TimeMap; append ?version=<14-digit-datetime> for a specific Memento. RFC 7089 Pattern 1.1 — OriginalResource doubles as TimeGate. See D61." .
