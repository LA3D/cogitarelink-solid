@prefix dct:      <http://purl.org/dc/terms/> .
@prefix prof:     <http://www.w3.org/ns/dx/prof/> .
@prefix wiki:     <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sub:      <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wikirole#> .

<> a sub:DerivedClassAffordance ,
       prof:ResourceDescriptor ;
   dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
   prof:hasRole wikirole:derived-class-affordance ;
   rdfs:label "Hub navigation" ;
   sub:deriveClass wiki:Hub ;
   sub:targetClass wiki:Resource ;
   sub:requiresCapability <https://pod.vardeman.me/vault/meta/capabilities/derived-view.ttl> ;
   sub:threshold 3 ;
   sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> ;
   rdfs:seeAlso <https://pod.vardeman.me/vault/meta/views/container-index> ;
   sh:agentInstruction "Hub navigation is served, not queried: each wiki container maintains a derived definition-line index.md child listing every member with its definition (see /vault/meta/views/container-index for the declared projection). Read the container's index.md, then navigate the concept's skos:broader / skos:narrower edges in its .meta. A concept with three or more inbound broader links is a hub." .
