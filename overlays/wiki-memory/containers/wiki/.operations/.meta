@prefix wiki:  <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix mem:   <https://pod.vardeman.me/vault/ontology/mem#> .
@prefix solid: <http://www.w3.org/ns/solid/terms#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix ldp:   <http://www.w3.org/ns/ldp#> .

<> a ldp:Container, ldp:BasicContainer ;
   dct:title "Wiki-memory operation log" ;
   dct:description "Append-only log of agent-emitted memory action announcements. Each entry is an as:Announce activity multi-typed with a mem:*Action class (COAR Notify pattern). Subscribe via Solid Notifications WebhookChannel2023 at /.notifications/ to receive new entries; or poll this container on agent wake to read what's happened across sessions." ;
   dct:isPartOf <https://pod.vardeman.me/vault/wiki/index.md> ;
   wiki:profileDocument <https://pod.vardeman.me/vault/wiki/index.md> ;
   wiki:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> ;
   sh:agentInstruction "Append-only by convention. Agents POST as:Announce activities multi-typed with a mem:*Action class as the last step of any memory action procedure. Treat older entries as immutable history. See </vault/wiki/index.md> for the full L3 profile and the operation-log discovery pattern in 'Cross-session orientation'." .
