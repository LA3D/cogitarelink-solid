@prefix wiki:   <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sub:  <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix solid:  <http://www.w3.org/ns/solid/terms#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix ldp:    <http://www.w3.org/ns/ldp#> .
@prefix schema: <https://schema.org/> .

<> a ldp:Container, ldp:BasicContainer ;
   dct:title "Wiki Procedures" ;
   solid:forClass schema:HowTo ;
   sub:shape </vault/meta/shapes/howto.shacl.ttl> ;
   ldp:constrainedBy </vault/meta/shapes/howto.shacl.ttl> ;
   sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> ;
   sh:agentInstruction "Procedural memory: how-tos, workflows, recipes. Typed as schema:HowTo. Body markdown carries the procedure; schema:step for structured access." .
