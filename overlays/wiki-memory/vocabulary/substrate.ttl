@prefix sub:    <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix wiki:   <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix mem:    <https://pod.vardeman.me/vault/ontology/mem#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix td:     <https://www.w3.org/2019/wot/td#> .

<https://pod.vardeman.me/vault/ontology/substrate>
    a owl:Ontology ;
    rdfs:label "Agentic substrate vocabulary" ;
    rdfs:comment "General agentic-substrate vocabulary (D107 Bucket 2): catalog/discovery pointers, class routing, predicate governance, and affordance-descriptor terms. The primitive view-definition layer — destined to merge into the view layer (RQ-Substrate-4 spec §4.3)." ;
    vann:preferredNamespacePrefix "sub" ;
    vann:preferredNamespaceUri "https://pod.vardeman.me/vault/ontology/substrate#" ;
    dct:conformsTo <https://www.w3.org/TR/owl2-overview/> ;
    dct:created "2026-05-28"^^xsd:date ;
    dct:creator <https://orcid.org/0000-0003-4091-6059> ;
    rdfs:seeAlso </vault/meta/extending-l3.md> .

# ============================================================
# Affordance descriptor classes
# ============================================================

sub:Affordance
    a rdfs:Class ;
    rdfs:subClassOf td:InteractionAffordance ;
    rdfs:label "Affordance" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Abstract root class for substrate affordance descriptors served from /vault/meta/affordances/. An affordance is a substrate behavior an agent can discover and invoke (or rely on) — content projection, derived views, search, time-travel, memory actions. Aligned with the W3C Web of Things (WoT) Thing Description: every sub:Affordance is a td:InteractionAffordance (https://www.w3.org/2019/wot/td#InteractionAffordance) — metadata that shows a Consumer how it may interact with this Pod, which plays the role of the WoT Thing. In WoT terms the affordance catalog at /vault/meta/affordances/ is this Pod's Thing Description." ;
    skos:scopeNote "Use a concrete subclass (sub:WriteAffordance, sub:DerivedClassAffordance, sub:DerivedNavigationAffordance, sub:VersionAffordance, sub:SearchAffordance, sub:QueryAffordance). Every affordance descriptor declares sub:installedBy, sh:agentInstruction (free-form guidance), and a subclass-specific payload (CONSTRUCT/SELECT query, governance lists, dispatch pattern). The WoT alignment is a hint, not an import: an agent that knows the WoT interaction model can reason about these affordances without dereferencing td:; one that doesn't can dereference https://www.w3.org/2019/wot/td." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/meta/affordances/example>:
        <> a sub:Affordance ;
           rdfs:label "Example affordance" ;
           sh:agentInstruction \"\"\"Free-form guidance for the agent.\"\"\" ;
           sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/> .

sub:WriteAffordance
    a rdfs:Class ;
    rdfs:subClassOf sub:Affordance ;
    rdfs:label "Write affordance" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Substrate-write configuration descriptor. Declares which predicates the substrate writes (sub:governs), which frontmatter keys project into .meta (sub:projectsFromFrontmatter), and which class-hint table the markdown-projection listener consults (sub:classHintTable). Consumed by capability cap:ContentProjection." ;
    skos:scopeNote "Used as rdf:type on the affordance descriptor at /vault/meta/affordances/markdown-projection. Agents read it to learn which predicates they should NOT PATCH .meta for directly (the substrate owns them), and which body+frontmatter idioms produce which RDF. Reference implementation: the markdown-projection extension." ;
    skos:example """
        <> a sub:WriteAffordance ;
           sub:governs rdf:type , wiki:maturity , dct:title ;
           sub:projectsFromFrontmatter "type" , "title" , "maturity" ;
           sub:classHintTable <../context.jsonld> ;
           sub:requiresCapability </vault/meta/capabilities/markdown-content-projection.ttl> ;
           sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/markdown-projection> .

sub:DerivedClassAffordance
    a rdfs:Class ;
    rdfs:subClassOf sub:Affordance ;
    rdfs:label "Derived class affordance" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Affordance descriptor for a substrate-computed class. Declares which class is derived (sub:deriveClass), which target class it applies to (sub:targetClass), a numeric threshold (sub:threshold) where applicable, and a SPARQL CONSTRUCT that materializes the derived rdf:type triples (sub:constructQuery)." ;
    skos:scopeNote "Used as rdf:type on /vault/meta/affordances/hub-view. The construct query is run client-side (Comunica or equivalent), with the Pod's wiki containers as sources — the Pod itself has no SPARQL endpoint. NOT used for affordances that don't derive a class (those are sub:DerivedNavigationAffordance for views or sub:SearchAffordance for query surfaces)." ;
    skos:example """
        <> a sub:DerivedClassAffordance ;
           sub:deriveClass wiki:Hub ;
           sub:targetClass wiki:Resource ;
           sub:threshold 3 ;
           sub:constructQuery \"\"\"CONSTRUCT { ?hub a wiki:Hub } WHERE { ?c skos:broader ?hub }\"\"\" ;
           sub:requiresCapability </vault/meta/capabilities/derived-view.ttl> ;
           sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/hub-view> .

sub:DerivedNavigationAffordance
    a rdfs:Class ;
    rdfs:subClassOf sub:Affordance ;
    rdfs:label "Derived navigation affordance" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Affordance descriptor for a substrate-computed navigation view (e.g., breadcrumb trails, MOC indexes). Carries a SPARQL SELECT (sub:selectQuery) the agent runs against the Pod's wiki containers." ;
    skos:scopeNote "Used as rdf:type on /vault/meta/affordances/breadcrumb-view. The select query produces tabular bindings (e.g., trail rows for a breadcrumb display). Different from sub:DerivedClassAffordance — derived navigation does not extend the class hierarchy, only computes a view." ;
    skos:example """
        <> a sub:DerivedNavigationAffordance ;
           sub:selectQuery \"\"\"SELECT ?ancestor ?depth WHERE { ?subject skos:broader+ ?ancestor }\"\"\" ;
           sub:requiresCapability </vault/meta/capabilities/derived-view.ttl> ;
           sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/breadcrumb-view> .

sub:VersionAffordance
    a rdfs:Class ;
    rdfs:subClassOf sub:Affordance ;
    rdfs:label "Version affordance" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Affordance descriptor for time-travel / versioning behaviors. Used by the Memento extension to advertise RFC 7089 conformance, TimeGate location, and supported operations (read-only vs writeable)." ;
    skos:scopeNote "Used as rdf:type on /vault/meta/affordances/memento. The descriptor's conformance pointers (wiki:conformsTo RFC 7089) tell an agent which time-travel protocol to use; the agent issues Accept-Datetime HTTP requests to the resource's TimeGate." ;
    skos:example """
        <> a sub:VersionAffordance ;
           wiki:conformsTo <http://www.rfc-editor.org/rfc/rfc7089.txt> ;
           sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#memento> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/memento> .

sub:SearchAffordance
    a rdfs:Class ;
    rdfs:subClassOf sub:Affordance ;
    rdfs:label "Search affordance" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Affordance descriptor for a query surface (recursive substring grep, SPARQL endpoint, type-filtered listing). Carries sub:targetContainer (root for the search), sub:dispatchPattern (URL query suffix that invokes the affordance), and sub:queryParameter blank nodes describing each accepted parameter." ;
    skos:scopeNote "Used as rdf:type on /vault/meta/affordances/wiki-search-grep. The descriptor pairs with an OSLC Query 3.0 / dct:conformsTo declaration so consumers can rely on the well-known parameter conventions. Agents discover the surface via Tier-1 Link rel=queryBase headers or via the affordance catalog at /vault/meta/affordances/." ;
    skos:example """
        <> a sub:SearchAffordance ;
           sub:targetContainer </vault/wiki/> ;
           sub:dispatchPattern "?ext=search-grep" ;
           sub:queryParameter [ sub:parameter "oslc.searchTerms" ; sub:required true ] ;
           dct:conformsTo <https://docs.oasis-open-projects.org/oslc-op/query/v3.0/oslc-query.html> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/wiki-search-grep> .

sub:QueryAffordance
    a rdfs:Class ;
    rdfs:subClassOf sub:Affordance , td:ActionAffordance ;
    rdfs:label "Query affordance" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Affordance descriptor for a parameterized, client-run SPARQL SELECT lookup over the Pod's .meta / contact graphs. Carries sub:selectQuery (the SPARQL with named parameters), sub:queryParameter blank nodes describing each binding, and an optional sub:targetContainer naming the source graph. Aligned with WoT td:ActionAffordance (https://www.w3.org/2019/wot/td#ActionAffordance): invoking a query is calling a function with input that returns a result set — it is NOT addressable state read like a td:PropertyAffordance, and NOT server-side ?ext= HTTP dispatch like sub:SearchAffordance. The query runs in the agent's own engine (Comunica), with the named source as data — the Pod hosts no SPARQL endpoint." ;
    skos:scopeNote "Used as rdf:type on the addressbook lookup descriptors at /vault/meta/affordances/{contact,org}-find-by-* and bridge-card-to-wiki. Distinct from sub:SearchAffordance (HTTP ?ext= dispatch, server-side) and sub:DerivedNavigationAffordance (computes a view, not a keyed lookup). Introduced 2026-05-24 via the wiki:ClassExtensionShape contract (D100), as the first extension applied to a substrate-meta class rather than a content class." ;
    skos:example """
        <> a sub:QueryAffordance , prof:ResourceDescriptor ;
           prof:hasRole wikirole:query-affordance ;
           rdfs:label "Find contact by name" ;
           dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
           sub:targetContainer </vault/contacts/people.ttl> ;
           sub:selectQuery \"\"\"SELECT ?person ?fn WHERE { ?person vcard:fn ?fn . FILTER(CONTAINS(LCASE(STR(?fn)), LCASE(STR($name)))) }\"\"\" ;
           sub:queryParameter [ sub:parameter "name" ; sub:required true ] ;
           sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#addressbook> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/> .

# ============================================================
# Affordance descriptor predicates (general)
# ============================================================

sub:governs
    a rdf:Property ;
    rdfs:label "governs" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Lists predicates that a substrate-write affordance (or its associated SHACL shape) owns — i.e., the agent must NOT PATCH them directly; instead edit the body+frontmatter and let the projection listener write them. Per D81 (predicate-level governance, Model A)." ;
    skos:scopeNote "Set on a sub:WriteAffordance descriptor OR on a sh:NodeShape that declares predicate-level governance. The complement (predicates not in this list) is agent-extensible: the agent may PATCH .meta freely for those. Use this to avoid write conflicts between the projection listener and direct agent PATCHes." ;
    rdfs:domain sub:Affordance ;
    rdfs:range rdf:Property ;
    skos:example """
        <> a sub:WriteAffordance ;
           sub:governs rdf:type , wiki:maturity , dct:title .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/markdown-projection> .

sub:projectsFromFrontmatter
    a rdf:Property ;
    rdfs:label "projects from frontmatter" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Lists YAML frontmatter keys that the markdown-projection listener reads from the body and projects into .meta triples on write. Each value is the frontmatter key as a literal string." ;
    skos:scopeNote "Set on a sub:WriteAffordance descriptor. Tells the agent: editing this frontmatter key WILL change the corresponding .meta triple. The mapping from key to RDF predicate is in the JSON-LD context referenced by sub:classHintTable." ;
    rdfs:domain sub:WriteAffordance ;
    rdfs:range xsd:string ;
    skos:example """
        <> a sub:WriteAffordance ;
           sub:projectsFromFrontmatter "type" , "title" , "maturity" , "concept" .
    """ ;
    rdfs:seeAlso sub:classHintTable .

sub:classHintTable
    a rdf:Property ;
    rdfs:label "class hint table" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at a JSON-LD context document that maps body wikilink class hints (e.g., the `.concept` in `[[Target]]{.concept}`) to RDF predicates. Used by the markdown-projection listener to project typed wikilinks into typed .meta edges." ;
    skos:scopeNote "Set on a sub:WriteAffordance descriptor. The agent reads the referenced context to learn which class hints are supported. Adding a class hint without updating the context = the wikilink projects to an untyped link (skos:related fallback)." ;
    rdfs:domain sub:WriteAffordance ;
    rdfs:range rdfs:Resource ;
    skos:example """
        <> a sub:WriteAffordance ;
           sub:classHintTable </vault/meta/context.jsonld> .
    """ ;
    rdfs:seeAlso </vault/meta/context.jsonld> .

sub:installedBy
    a rdf:Property ;
    rdfs:label "installed by" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Provenance pointer linking an artifact (affordance descriptor, capability, shape, profile, vocabulary fragment) back to the overlay that installed it. Lets the substrate trace which overlay owns a given artifact when overlays are uninstalled or upgraded." ;
    skos:scopeNote "Set on any artifact installed by an overlay. Object is the overlay's identifying IRI (typically <https://pod.vardeman.me/vault/ontology/overlay#<name>>). Single-valued in practice — an artifact belongs to one overlay." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        <> a sub:WriteAffordance ;
           sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#wiki-memory> .
    """ ;
    rdfs:seeAlso </vault/meta/capabilities/> .

sub:shape
    a rdf:Property ;
    rdfs:label "shape" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at a SHACL NodeShape (typically in /vault/meta/shapes/) that validates instances of a given class or container." ;
    skos:scopeNote "Used on capability or affordance descriptors that need to advertise an associated shape, or on profile descriptors that list their constraint resources. For per-container constraint binding, prefer LDP's ldp:constrainedBy on the container's .meta." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range sh:NodeShape ;
    skos:example """
        <> a sub:Affordance ;
           sub:shape </vault/meta/shapes/concept.ttl> .
    """ ;
    rdfs:seeAlso </vault/meta/shapes/> .

sub:requiresCapability
    a rdf:Property ;
    rdfs:label "requires capability" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Declares that an affordance requires a specific substrate capability descriptor (in /vault/meta/capabilities/). Lets an agent verify the affordance is fully wired before relying on it." ;
    skos:scopeNote "Set on a sub:Affordance descriptor. Object is a capability descriptor IRI. Multiple values allowed when an affordance needs more than one capability. Agents SHOULD dereference the capability to confirm the substrate genuinely provides the named behavior; absence of the capability = the affordance descriptor is stale." ;
    rdfs:domain sub:Affordance ;
    rdfs:range rdfs:Resource ;
    skos:example """
        <> a sub:WriteAffordance ;
           sub:requiresCapability </vault/meta/capabilities/markdown-content-projection.ttl> .
    """ ;
    rdfs:seeAlso </vault/meta/capabilities/> .

sub:deriveClass
    a rdf:Property ;
    rdfs:label "derive class" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "On a sub:DerivedClassAffordance, names the class IRI the affordance materializes (e.g., wiki:Hub). The derived class is added as rdf:type via the affordance's CONSTRUCT query." ;
    skos:scopeNote "Single-valued per affordance. Distinct from sub:targetClass (which scopes the input set the CONSTRUCT runs over)." ;
    rdfs:domain sub:DerivedClassAffordance ;
    rdfs:range rdfs:Class ;
    skos:example """
        <> a sub:DerivedClassAffordance ;
           sub:deriveClass wiki:Hub .
    """ ;
    rdfs:seeAlso sub:targetClass .

sub:targetClass
    a rdf:Property ;
    rdfs:label "target class" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "On a sub:DerivedClassAffordance, names the class whose instances are eligible to be classified as the derived class. Lets the affordance scope its CONSTRUCT over a specific subset of the wiki content." ;
    skos:scopeNote "Single-valued per affordance. Different from sh:targetClass (a SHACL property used inside shapes) — sub:targetClass appears only on derived-class affordance descriptors." ;
    rdfs:domain sub:DerivedClassAffordance ;
    rdfs:range rdfs:Class ;
    skos:example """
        <> a sub:DerivedClassAffordance ;
           sub:deriveClass wiki:Hub ;
           sub:targetClass wiki:Resource .
    """ ;
    rdfs:seeAlso sub:deriveClass , sh:targetClass .

sub:routesToClass
    a rdf:Property ;
    rdfs:label "routes to class"@en ;
    rdfs:comment "Substrate-scoped addressing relation: a wikilink edge using this predicate routes its target resource into the container registered (in the Type Index) for the named class. This is NOT a global rdfs:range claim about the predicate — it is this Pod's routing entailment (D106). The target's authoritative type remains the target's own <#this> a … (D81)."@en ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:domain rdf:Property ;
    rdfs:range rdfs:Class ;
    dct:conformsTo <http://www.w3.org/2000/01/rdf-schema> ;
    dct:created "2026-05-26"^^xsd:date ;
    dct:creator <https://orcid.org/0000-0003-4091-6059> .

sub:threshold
    a rdf:Property ;
    rdfs:label "threshold" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Numeric threshold parameter for a derived-class or derived-navigation affordance. For wiki:Hub this is the minimum incoming-edge count (default 3). Surfaces the magic number so consumers can adjust their UX expectations." ;
    skos:scopeNote "Single-valued per affordance, typed xsd:integer. The affordance's CONSTRUCT/SELECT query usually references this value directly (HAVING (COUNT(?x) >= 3)); changing the threshold requires editing the query as well." ;
    rdfs:domain sub:Affordance ;
    rdfs:range xsd:integer ;
    skos:example """
        <> a sub:DerivedClassAffordance ;
           sub:threshold 3 .
    """ .

sub:constructQuery
    a rdf:Property ;
    rdfs:label "CONSTRUCT query" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "SPARQL CONSTRUCT body, as an xsd:string, that an agent runs against the Pod's wiki containers (client-side, no Pod SPARQL endpoint) to materialize a derived view." ;
    skos:scopeNote "Set on sub:DerivedClassAffordance. Pre-resolved prefixes are conventionally inlined in the query string (PREFIX wiki: ..., PREFIX skos: ...) so the agent can copy-paste into Comunica without context. NOT used for SELECT queries — those are sub:selectQuery." ;
    rdfs:domain sub:Affordance ;
    rdfs:range xsd:string ;
    skos:example """
        <> a sub:DerivedClassAffordance ;
           sub:constructQuery \"\"\"PREFIX wiki: <https://pod.vardeman.me/vault/ontology/wiki#>
              CONSTRUCT { ?hub a wiki:Hub }
              WHERE { ?c skos:broader ?hub }\"\"\" .
    """ ;
    rdfs:seeAlso sub:selectQuery .

sub:selectQuery
    a rdf:Property ;
    rdfs:label "SELECT query" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "SPARQL SELECT body, as an xsd:string, that an agent runs client-side over the Pod's wiki containers to compute a derived view (breadcrumb trail, listing, search result table)." ;
    skos:scopeNote "Set on sub:DerivedNavigationAffordance and sub:SearchAffordance. Pre-resolved prefixes conventionally inlined. NOT used for class-deriving affordances (those are sub:constructQuery)." ;
    rdfs:domain sub:Affordance ;
    rdfs:range xsd:string ;
    skos:example """
        <> a sub:DerivedNavigationAffordance ;
           sub:selectQuery \"\"\"SELECT ?ancestor ?depth WHERE { ?subject skos:broader+ ?ancestor }\"\"\" .
    """ ;
    rdfs:seeAlso sub:constructQuery .

# ============================================================
# Search-affordance predicates
# ============================================================

sub:targetContainer
    a rdf:Property ;
    rdfs:label "target container" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "The LDP container an affordance applies to. Wiki-search uses it to scope grep recursion; agents read it to learn where to send their query." ;
    skos:scopeNote "Single-valued per affordance. Object is a container URL (typically ends with /). For a Pod-wide search affordance, use </vault/wiki/>; for a class-scoped affordance, use the class's instance container (e.g., </vault/wiki/concepts/>)." ;
    rdfs:domain sub:Affordance ;
    rdfs:range rdfs:Resource ;
    skos:example """
        <> a sub:SearchAffordance ;
           sub:targetContainer </vault/wiki/> .
    """ .

sub:dispatchPattern
    a rdf:Property ;
    rdfs:label "dispatch pattern" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "URL query-string suffix that activates an affordance against its target container. For wiki-search-grep this is `?ext=search-grep` — appending it to the container URL invokes the affordance." ;
    skos:scopeNote "Single-valued per affordance. Typed xsd:string. The pattern is appended to the sub:targetContainer URL; query parameters follow. Agents that consume the affordance compose `<targetContainer><dispatchPattern>&<query parameters>`." ;
    rdfs:domain sub:Affordance ;
    rdfs:range xsd:string ;
    skos:example """
        <> a sub:SearchAffordance ;
           sub:dispatchPattern "?ext=search-grep" .
    """ .

sub:queryParameter
    a rdf:Property ;
    rdfs:label "query parameter" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Declares an accepted query parameter for an affordance. Object is a blank node carrying sub:parameter (the name), sub:required (bool), and optionally rdfs:comment (free-form description)." ;
    skos:scopeNote "Repeat once per accepted parameter. Lets the agent enumerate the parameter surface without fetching documentation. NOT for shape constraints on the parameter values; that's still free-form for v1." ;
    rdfs:domain sub:Affordance ;
    rdfs:range rdfs:Resource ;
    skos:example """
        <> a sub:SearchAffordance ;
           sub:queryParameter [ sub:parameter "oslc.searchTerms" ; sub:required true ] ,
                              [ sub:parameter "oslc.pageSize" ; sub:required false ] .
    """ ;
    rdfs:seeAlso sub:parameter , sub:required .

sub:parameter
    a rdf:Property ;
    rdfs:label "parameter" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "The name of a query parameter, as an xsd:string. Object of sub:queryParameter blank nodes." ;
    skos:scopeNote "Single-valued per blank node. The name MUST match the wire-form parameter the affordance accepts (e.g., 'oslc.searchTerms' not 'searchTerms')." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    skos:example """
        [ sub:parameter "oslc.searchTerms" ; sub:required true ]
    """ .

sub:required
    a rdf:Property ;
    rdfs:label "required" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Whether a query parameter is required for the affordance to be invoked. Object of sub:queryParameter blank nodes." ;
    skos:scopeNote "Typed xsd:boolean. True = the agent MUST supply this parameter. False (or absent) = optional with documented defaults (see rdfs:comment on the blank node)." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:boolean ;
    skos:example """
        [ sub:parameter "oslc.searchTerms" ; sub:required true ]
    """ .

# ============================================================
# Storage-description / catalog-pointer predicates
# ============================================================

sub:contextDocument
    a rdf:Property ;
    rdfs:label "context document" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at the JSON-LD context document at /vault/meta/context.jsonld. The context defines short-form predicates and class-hint mappings used by the markdown-projection listener and by clients composing JSON-LD bodies." ;
    skos:scopeNote "Used at the storage-description level (on /vault/.well-known/solid) to advertise the canonical prefix→IRI registry. A blind agent fetches the value of this predicate to learn the short-form vocabulary the substrate uses on the wire." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:contextDocument </vault/meta/context.jsonld> .
    """ ;
    rdfs:seeAlso </vault/meta/context.jsonld> .

sub:shapeCatalog
    a rdf:Property ;
    rdfs:label "shape catalog" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at the LDP container of SHACL shapes (/vault/meta/shapes/). An agent dereferencing /vault/.well-known/solid follows this predicate to enumerate the shape catalog." ;
    skos:scopeNote "Used at the storage-description level. Object is a container URL (trailing slash). To learn which shape validates a given class, GET the container and inspect the .meta of each contained shape file for sh:targetClass." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:shapeCatalog </vault/meta/shapes/> .
    """ ;
    rdfs:seeAlso </vault/meta/shapes/> .

sub:affordanceCatalog
    a rdf:Property ;
    rdfs:label "affordance catalog" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at the LDP container of affordance descriptors (/vault/meta/affordances/). Per D52, an agent dereferencing /vault/.well-known/solid follows this predicate to discover substrate behaviors (write affordances, derived views, search, time-travel)." ;
    skos:scopeNote "Used at the storage-description level. Each item in the container is a sub:Affordance subclass descriptor with sh:agentInstruction prose plus a typed payload (CONSTRUCT/SELECT, governance lists, dispatch pattern)." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:affordanceCatalog </vault/meta/affordances/> .
    """ ;
    rdfs:seeAlso </vault/meta/affordances/> .

sub:identifierSchemeCatalog
    a rdf:Property ;
    rdfs:label "identifier-scheme catalog" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points from a storage description to the Pod-level identifier-scheme catalog (D111). The catalog is a dcat:Catalog of dereferenceable scheme records whose fragment IRIs are the datatypes of identifier literals." ;
    skos:scopeNote "Used at the storage-description level. The catalog lives at /id/schemes/, OUTSIDE the /vault/ storage root, so scheme datatype IRIs survive a storage-root rename. An agent resolving a typed identifier literal (e.g. \"10.1234/x\"^^</id/schemes/doi>) dereferences the datatype IRI to learn the scheme's resolution providers and minting roles." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:identifierSchemeCatalog </id/schemes/> .
    """ ;
    rdfs:seeAlso </id/schemes/> .

sub:capabilityCatalog
    a rdf:Property ;
    rdfs:label "capability catalog" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at the LDP container of capability descriptors (/vault/meta/capabilities/). Per D83 (Pod-as-toolkit), capabilities are reusable substrate behaviors that affordances reference via sub:requiresCapability." ;
    skos:scopeNote "Used at the storage-description level. Distinct from sub:affordanceCatalog: capabilities are reusable building blocks (ContentProjection, DerivedView, TimeTravel); affordances are user-facing behavior descriptors that compose one or more capabilities." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:capabilityCatalog </vault/meta/capabilities/> .
    """ ;
    rdfs:seeAlso </vault/meta/capabilities/> .

sub:contactCatalog
    a rdf:Property ;
    rdfs:label "contact catalog" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at the AddressBook contact catalog (/vault/contacts/). Used by the AddressBook substrate overlay; orthogonal to wiki:Person at /vault/wiki/people/ (narrative-memory people) — sub:contactCatalog is the operational vCard contact store." ;
    skos:scopeNote "Used at the storage-description level. An agent doing contact lookup (find-by-orcid, find-by-name) starts from this predicate. A general substrate catalog pointer (D107): the AddressBook overlay was previously forced to reuse the wiki: namespace for this — the contamination smoking gun, now fixed." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:contactCatalog </vault/contacts/> .
    """ ;
    rdfs:seeAlso </vault/contacts/> , wiki:Person .

sub:templateCatalog
    a rdf:Property ;
    rdfs:label "template catalog" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at the substrate template catalog (/vault/meta/templates/). Templates encode the tmpl: vocabulary for cold-start resource creation (D88) — they pair a target container or resource with a parameterized body that satisfies the destination shape." ;
    skos:scopeNote "Used at the storage-description level. An agent wanting to create a class-conformant resource without inventing the body GETs this catalog and finds the matching tmpl:targetContainer / tmpl:targetResource template, substitutes parameters, and PUT/PATCHes." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:templateCatalog </vault/meta/templates/> .
    """ ;
    rdfs:seeAlso </vault/meta/templates/> .

sub:profileDocument
    a rdf:Property ;
    rdfs:label "profile document" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at the wiki-memory L3 synthesis page (typically /vault/wiki/index.md) from any resource that wants to declare conformance to this substrate. Subject is any resource; object is the synthesis page URL. Used for U-shape reinforcement: every substrate self-description resource links back to the synthesis." ;
    skos:scopeNote "Use on /vault/.well-known/solid and on resource .meta where the resource wants to point a blind agent at the L3 narrative entry point. Distinct from dct:conformsTo (which points at a profile-of-conformance, not a human-readable page)." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range wiki:Page ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:profileDocument </vault/wiki/index.md> .
    """ ;
    rdfs:seeAlso </vault/wiki/index.md> .

sub:bootstrapResource
    a rdf:Property ;
    rdfs:label "bootstrap resource" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at a resource a blind agent should fetch during cold-start orientation. Subject is the synthesis page; object is a catalog or descriptor needed for bootstrap. Multiple instances expected per synthesis." ;
    skos:scopeNote "Use on the wiki-memory synthesis page to enumerate the catalogs (shapes, affordances, capabilities, Type Index) and key descriptors a blind agent must read before issuing writes. Distinct from rdfs:seeAlso (which is loose cross-reference) — bootstrapResource is a strict 'read this' obligation." ;
    rdfs:domain wiki:Page ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/wiki/index.md.meta:
        <> sub:bootstrapResource </vault/.well-known/solid> ,
                                </vault/meta/shapes/> ,
                                </vault/meta/affordances/> ,
                                </vault/settings/publicTypeIndex> .
    """ ;
    rdfs:seeAlso </vault/.well-known/solid> .

sub:eventStream
    a rdf:Property ;
    rdfs:label "event stream" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Points at a substrate's event inbox (typically /vault/wiki/.events/), a sibling concept to ldp:inbox. Distinguishes substrate-emitted analysis events (mem:Event subclasses) from peer-emitted inbox notifications (ldp:inbox)." ;
    skos:scopeNote "Use on the synthesis page or on /vault/.well-known/solid to advertise the event source. An agent subscribes via Solid Notifications against this URL to receive mem:Event instances. NOT for outbound posting — agents do not POST events; the substrate owns event production." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/wiki/index.md.meta:
        <> sub:eventStream </vault/wiki/.events/> .
    """ ;
    rdfs:seeAlso mem:Event , </vault/wiki/.events/> .

sub:agentGuide
    a rdf:Property ;
    rdfs:label "agent guide"@en ;
    rdfs:comment "IRI pointer to a human- and agent-readable document that explains how to use this substrate. Satisfies the entry-point orientation requirement on the storage description when sh:agentInstruction (a string literal) cannot be used (StaticStorageDescriber emits IRIs, not literals)."@en ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    dct:conformsTo <http://www.w3.org/2000/01/rdf-schema> ;
    dct:created "2026-05-27"^^xsd:date ;
    dct:creator <https://orcid.org/0000-0003-4091-6059> .

sub:extensionGuide
    a rdf:Property ;
    rdfs:label "extension guide"@en ;
    rdfs:comment "IRI pointer to the L4 extension guide document (typically /vault/meta/extending-l3.md) that explains how to extend a substrate vocabulary or shape catalog. Advertised on the storage description so agents arriving cold can dereference and read the manual without prior knowledge (D100). Distinct from wiki:ExtensionGuide (the rdfs:Class of such guide pages); this is the storage-description pointer predicate." ;
    skos:scopeNote "Used at the storage-description level. Object is the extension-guide document IRI. Pairs with the wiki:ExtensionGuide class that types the document itself." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    skos:example """
        # In /vault/.well-known/solid:
        <> sub:extensionGuide </vault/meta/extending-l3.md> .
    """ ;
    rdfs:seeAlso </vault/meta/extending-l3.md> .

# ─────────────────────────────────────────────────────────────
# Frame-model spine (D108) — make each content shape's node-frame
# machine-readable on the shape itself (the normative spine).
# ─────────────────────────────────────────────────────────────

sub:frameRole
    a rdf:Property ;
    rdfs:label "frame role" ;
    rdfs:comment "The node-frame a content SHACL shape governs: \"page\", \"thing\", or \"concept\" (D108)." ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:domain sh:NodeShape ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "page = the document resource <>; thing = the entity <#this>; concept = a SKOS unit at <#this>. Read this off a shape to learn which frame it enforces." .

sub:governsSubject
    a rdf:Property ;
    rdfs:label "governs subject" ;
    rdfs:comment "Which subject of a wiki page's .meta the shape governs: the page document (<>) or the entity (<#this>) (D96/D108)." ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:domain sh:NodeShape ;
    rdfs:range rdfs:Literal ;
    skos:scopeNote "Literal token \"<>\" (page document) or \"<#this>\" (entity). PageShape governs <>; Thing/Concept shapes govern <#this>." .

sub:labelProperty
    a rdf:Property ;
    rdfs:label "label property" ;
    rdfs:comment "The canonical label property for this shape's frame: dct:title (page), schema:name (thing), or skos:prefLabel (concept) (D108)." ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:domain sh:NodeShape ;
    rdfs:range rdf:Property ;
    skos:scopeNote "The label property an agent must supply (or the substrate must materialize) for a node of this frame. Concepts use skos:prefLabel because the conceptual backbone is SKOS." .

# ============================================================
# View layer (D107 §6 / 2026-06-07 view-layer spec)
# ============================================================

sub:View
    a rdfs:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/dx/prof/Profile> ;
    rdfs:label "View" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "A negotiable representation of pod resources: a PROF profile whose role:mapping artifact is the declared projection query. Selected via ?_profile={token} (conneg-by-profile QSA)." ;
    skos:scopeNote "Views are PROF profiles — each view descriptor declares prof:hasResource artifacts (the projection query, the shape governing the view's output). sub:realization declares whether the view is assembled per-request (sub:Virtual) or stored and rederivable (sub:Materialized). sub:writable carries the lens law: a view is writable iff its get admits a well-behaved put (lossy/derived views are read-only, writes return 405). sub:servesAt is used only for cross-cutting views that mint a new URL space; per-resource views selected by ?_profile= omit it." ;
    rdfs:seeAlso <https://www.w3.org/TR/dx-prof/> .

sub:RealizationMode
    a rdfs:Class ;
    rdfs:label "realization mode" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "Abstract class for the two ways a view can be produced. Concrete instances are sub:Virtual and sub:Materialized." .

sub:Virtual
    a sub:RealizationMode ;
    rdfs:label "virtual realization" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "The view is assembled per-request from the underlying resources. No stored copy; always reflects current state." .

sub:Materialized
    a sub:RealizationMode ;
    rdfs:label "materialized realization" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:comment "The view is stored as a derived resource and is rederivable on demand. Enables efficient retrieval at the cost of potential staleness." .

sub:realization
    a rdf:Property ;
    rdfs:label "realization" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:domain sub:View ;
    rdfs:range sub:RealizationMode ;
    rdfs:comment "How the view is produced: sub:Virtual (assembled per request) or sub:Materialized (stored, rederivable)." ;
    skos:scopeNote "Single-valued per view descriptor. An agent reading this predicate learns whether it can rely on a stored representation — sub:Materialized (a pre-computed representation served as-is — still selected via ?_profile={token} for per-resource views; assembly happens at write/derive time rather than per request) — or must request assembly each time: sub:Virtual (pass ?_profile= on each request)." ;
    skos:example """
        <> a sub:View ;
           sub:realization sub:Virtual .
    """ .

sub:writable
    a rdf:Property ;
    rdfs:label "writable" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:domain sub:View ;
    rdfs:range xsd:boolean ;
    rdfs:comment "The lens law as data: a view is writable iff its get admits a well-behaved put. Lossy/derived views are read-only (writes get 405)." ;
    skos:scopeNote "Typed xsd:boolean. true = the view supports write-back (PUT/PATCH to the view URL propagates to the underlying resource). false (or absent) = the view is read-only; the server returns 405 on write attempts. Agents SHOULD check this before attempting a PUT through a view." ;
    skos:example """
        <> a sub:View ;
           sub:writable false .
    """ .

sub:servesAt
    a rdf:Property ;
    rdfs:label "serves at" ;
    rdfs:isDefinedBy <https://pod.vardeman.me/vault/ontology/substrate> ;
    rdfs:domain sub:View ;
    rdfs:range rdfs:Resource ;
    rdfs:comment "For cross-cutting views: the URL space (container) this view mints. Per-resource views (selected by ?_profile= on existing URLs) omit this." ;
    skos:scopeNote "Used when a view projects a union or cross-cut of existing resources under a new URL (e.g., a people cross-cut at /vault/views/people/). Per-resource views that are accessed by appending ?_profile={token} to an existing resource URL do not need this predicate." ;
    skos:example """
        <> a sub:View ;
           sub:servesAt </vault/views/people/> .
    """ .
