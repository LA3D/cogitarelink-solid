@prefix wiki:   <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sub:    <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix mem:    <https://pod.vardeman.me/vault/ontology/mem#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix td:     <https://www.w3.org/2019/wot/td#> .

<https://pod.vardeman.me/vault/ontology/wiki>
    a owl:Ontology ;
    rdfs:label "Wiki-memory L3 vocabulary" ;
    rdfs:comment "Substrate-minted classes and properties for the wiki-memory L3 reference profile. Composes with schema.org, SKOS, FOAF, CITO, PROV, DCT; mints wiki:* only for genuine gaps per D79." ;
    vann:preferredNamespacePrefix "wiki" ;
    vann:preferredNamespaceUri "https://pod.vardeman.me/vault/ontology/wiki#" ;
    dct:conformsTo <https://www.w3.org/TR/owl2-overview/> ;
    dct:created "2026-05-19"^^xsd:date ;
    dct:creator <https://orcid.org/0000-0003-4091-6059> ;
    rdfs:seeAlso </vault/meta/extending-l3.md> .

# ============================================================
# Class hierarchy — wiki:Resource and its subclasses
# ============================================================

wiki:Resource
    a rdfs:Class ;
    rdfs:label "Wiki resource" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Abstract root class for all wiki-memory L3 content. Any resource hosted under /vault/wiki/ that participates in the L3 profile is a wiki:Resource (directly or via a subclass)." ;
    skos:scopeNote "Rarely used as rdf:type directly — prefer a concrete subclass (wiki:Concept, wiki:Source, wiki:Person, wiki:Procedure, wiki:WorkingNote). Used as a SHACL sh:targetClass when a shape applies to all wiki content regardless of subclass (e.g., the resource.shacl.ttl shape governs invariants every wiki:Resource must hold)." ;
    skos:example """
        # In a shape governing all wiki content:
        wiki:ResourceShape a sh:NodeShape ;
            sh:targetClass wiki:Resource ;
            sh:property [ sh:path dct:title ; sh:minCount 1 ] .
    """ ;
    rdfs:seeAlso </vault/meta/shapes/resource.ttl> .

wiki:Page
    a owl:Class ;
    rdfs:subClassOf wiki:Resource ;
    rdfs:label "Wiki Page" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "An information resource (markdown body + .meta sidecar) in the wiki-memory L3 substrate. Each wiki:Page describes exactly one Thing via schema:mainEntity. The Thing IRI is the page's <#this> fragment." ;
    skos:definition "The page-resource side of the dual-layer L3 architecture. Pages are information resources; the Things they describe are the queryable entities." ;
    skos:scopeNote "1-to-1 with the Thing it describes. For multiple pages per Thing, use mem:SupersedeAction." ;
    rdfs:seeAlso </vault/meta/extending-l3.md> ;
    dct:created "2026-05-19"^^xsd:date ;
    dct:creator <https://orcid.org/0000-0003-4091-6059> .

wiki:Source
    a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Source" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Citation record / literature note. A skos:Concept subclass adding a required external identifier (DOI, arXiv ID, or citekey). Default container is /vault/wiki/concepts/. Represents an external work (paper, book, blog post, dataset) referenced by wiki content via dct:source or cito:cites. First worked example of the class-extension contract (D98)." ;
    skos:scopeNote "Use as rdf:type on resources in /vault/wiki/concepts/ that record bibliographic metadata for external works. Inherits ConceptShape (skos + cito citation edges). NOT used for internal cross-references between wiki resources — those are skos:related / cito:extends / cito:agreesWith edges on the resource itself." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/concepts/hu-2026-beyond-rag.md.meta>:
        <> a wiki:Source ;
           skos:prefLabel "Beyond RAG: ..." ;
           dct:identifier "arXiv:2601.00000" ;
           dct:contributor <https://pod.vardeman.me/vault/wiki/people/hu-jian.md> .
    """ ;
    rdfs:seeAlso </vault/wiki/concepts/> , </vault/meta/shapes/source.shacl.ttl> .

wiki:Person
    a rdfs:Class ;
    rdfs:subClassOf wiki:Resource , foaf:Person ;
    rdfs:label "Person" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Person record. Default container is /vault/wiki/people/. Subclass of foaf:Person so existing FOAF tooling can discover wiki people. Each Person record canonicalizes a single human identity used as dct:creator / dct:contributor across wiki content." ;
    skos:scopeNote "Use as rdf:type on resources in /vault/wiki/people/. For Pod-owner identity, use the WebID at /vault/profile/card#me — Person records in /vault/wiki/people/ are bibliography-class records for cited authors, collaborators, and subjects, not WebIDs. The AddressBook substrate at /vault/contacts/ holds vCard contacts; wiki:Person at /vault/wiki/people/ is the narrative-memory counterpart." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/people/hu-jian.md.meta>:
        <> a wiki:Person , foaf:Person ;
           foaf:name "Jian Hu" ;
           owl:sameAs <https://orcid.org/0000-0000-0000-0000> .
    """ ;
    rdfs:seeAlso </vault/wiki/people/> , </vault/meta/shapes/person.ttl> , </vault/contacts/> .

wiki:Procedure
    a rdfs:Class ;
    rdfs:subClassOf wiki:Resource ;
    rdfs:label "Procedure" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Procedural memory record. Default container is /vault/wiki/procedures/. Captures a reusable how-to: ordered steps, optional precondition, optional postcondition. Counterpart to declarative content (wiki:Concept) in the CoALA memory partition model." ;
    skos:scopeNote "Use as rdf:type on resources that document a procedure (workflow, recipe, repeatable analysis). A procedure SHOULD carry an ordered wiki:procedure (rdf:List of wiki:step strings) plus optional wiki:precondition / wiki:postcondition / wiki:errorMode. Do NOT use for narrative essays describing how something happened once — that's wiki:Page or wiki:Concept." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/procedures/crystallize.md.meta>:
        <> a wiki:Procedure ;
           dct:title "How to crystallize a working note" ;
           wiki:precondition "Working note has dct:title and at least one concept reference." ;
           wiki:procedure ( "GET working note" "Validate against destination shape" "PUT to destination" "DELETE working note" ) ;
           wiki:postcondition "Durable resource exists; working URL returns 404." .
    """ ;
    rdfs:seeAlso </vault/wiki/procedures/> , </vault/meta/shapes/procedure.ttl> .

wiki:WorkingNote
    a owl:Class ;
    rdfs:subClassOf wiki:Page ;
    rdfs:label "Working Note" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Permissive subclass of wiki:Page for D73 two-stage commit drafting. Working notes accept any Thing type without strict validation. mem:CrystallizeAction promotes them to durable containers." ;
    skos:scopeNote "Used only for low-ceremony body-only writes. Strict validation happens at crystallize-time." ;
    rdfs:seeAlso </vault/meta/affordances/crystallize> ;
    dct:created "2026-05-19"^^xsd:date .

wiki:ExtensionGuide
    a owl:Class ;
    rdfs:subClassOf schema:HowTo ;
    rdfs:label "Extension Guide" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "A wiki page documenting how to extend a substrate vocabulary or shape catalog. Canonical instance: /vault/meta/extending-l3.md." ;
    rdfs:seeAlso </vault/meta/extending-l3.md> ;
    dct:created "2026-05-19"^^xsd:date .

# ----- wiki:Page subclasses -----

wiki:Concept
    a rdfs:Class ;
    rdfs:subClassOf wiki:Page , skos:Concept ;
    rdfs:label "Concept" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Atomic conceptual knowledge unit. Subclass of skos:Concept so SKOS hierarchies (skos:broader / skos:narrower) compose with wiki content. The default class for wiki content that names and explains a single idea." ;
    skos:scopeNote "Use as rdf:type on resources that name a single concept (a theorem, a pattern, a definition). Default container is /vault/wiki/concepts/ if available (else /vault/wiki/pages/ per the Type Index). A wiki:Concept SHOULD have skos:prefLabel + dct:title + at least one outgoing edge (skos:broader, wiki:extends, or dct:source). NOT used for multi-concept essays — split those into wiki:Concept records and link." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/concepts/bounded-branching.md.meta>:
        <> a wiki:Concept ;
           dct:title "Bounded branching" ;
           skos:prefLabel "Bounded branching" ;
           skos:broader <https://pod.vardeman.me/vault/wiki/concepts/wiki-memory-l3.md> ;
           dct:source <https://pod.vardeman.me/vault/wiki/sources/hu-2026-beyond-rag.md> .
    """ ;
    rdfs:seeAlso </vault/meta/profiles/concept> .

wiki:MOC
    a rdfs:Class ;
    rdfs:subClassOf wiki:Page ;
    rdfs:label "Map of Content" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Navigational hub page that organizes other pages by topic. Authored by agents (in contrast to wiki:Hub, which is substrate-derived from inbound skos:broader counts). MOCs are the curated counterpart to derived hubs." ;
    skos:scopeNote "Use when an agent has assembled a curated set of pointers (dct:hasPart) to other wiki resources under a topic banner. Distinct from wiki:Hub — MOCs are authored; Hubs are substrate-computed. A page MAY be both wiki:MOC AND wiki:Hub when curation coincides with derived-class threshold." ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/pages/agentic-memory-moc.md.meta>:
        <> a wiki:MOC , wiki:Page ;
           dct:title "Agentic Memory MOC" ;
           dct:hasPart <https://pod.vardeman.me/vault/wiki/concepts/context-graphs.md> ,
                       <https://pod.vardeman.me/vault/wiki/concepts/procedural-memory.md> .
    """ ;
    rdfs:seeAlso wiki:Hub .

wiki:Hub
    a rdfs:Class ;
    rdfs:subClassOf wiki:Resource ;
    rdfs:label "Hub" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Derived class: a wiki:Resource with ≥3 incoming skos:broader edges. Substrate-computed via the hub-view affordance; agents do NOT assert wiki:Hub directly. Threshold is configurable in the DerivedClassAffordance descriptor." ;
    skos:scopeNote "Never asserted as rdf:type by agents — wiki:Hub is materialized by SPARQL CONSTRUCT run against the Pod's wiki containers (Comunica or equivalent). To check whether a resource IS a Hub, run the construct query in /vault/meta/affordances/hub-view. The substrate provides the affordance; the agent runs it in its own engine (the Pod has no SPARQL endpoint)." ;
    skos:example """
        # CONSTRUCT (run client-side via Comunica) that materializes wiki:Hub:
        CONSTRUCT { ?hub a wiki:Hub }
        WHERE {
          ?child skos:broader ?hub .
          ?hub a wiki:Resource .
        }
        GROUP BY ?hub HAVING (COUNT(?child) >= 3)
    """ ;
    rdfs:seeAlso </vault/meta/affordances/hub-view> , wiki:MOC .

# ============================================================
# Lifecycle: wiki:maturity + skos values
# ============================================================

wiki:maturity
    a rdf:Property ;
    rdfs:label "maturity" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Lifecycle marker on a wiki:Resource. Values are skos:Concepts from this vocabulary: wiki:draft (initial), wiki:validated (passed shape + content review), wiki:core (deeply integrated — ≥3 incoming typed edges)." ;
    skos:scopeNote "Authored by the agent that owns the resource. Promotions from draft to validated require the resource passes its shape AND a content review. Promotion to core is computed (≥3 incoming typed edges); demote back if the count drops. Distinct from the SKOS hierarchy edges (skos:broader); maturity is orthogonal to topical structure." ;
    rdfs:domain wiki:Resource ;
    rdfs:range skos:Concept ;
    skos:example """
        # In <https://pod.vardeman.me/vault/wiki/concepts/foo.md.meta>:
        <> a wiki:Concept ;
           wiki:maturity wiki:validated .
    """ ;
    rdfs:seeAlso wiki:draft , wiki:validated , wiki:core .

wiki:draft
    a skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:prefLabel "draft" ;
    skos:scopeNote "Initial lifecycle state. Default for new resources. Promote to wiki:validated after the resource passes its SHACL shape AND a content-quality review." .

wiki:validated
    a skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:prefLabel "validated" ;
    skos:scopeNote "Resource has passed shape conformance AND content-quality review. Eligible for promotion to wiki:core once ≥3 distinct wiki:Resource instances point at it via typed edges (skos:broader, wiki:extends, dct:source, etc.)." .

wiki:core
    a skos:Concept ;
    rdfs:isDefinedBy <> ;
    skos:prefLabel "core" ;
    skos:scopeNote "Resource is well-integrated structurally: ≥3 incoming typed edges. Promotion is computed by the substrate, not asserted by the agent. Demote back to wiki:validated if the incoming-edge count falls below threshold." .

# ============================================================
# Affordance descriptor predicates (NEW Phase A — Memory Structuring Sprint)
# Predicates documenting an affordance's contract — what mem:Action it performs,
# its pre/post conditions, its failure modes, and its procedural steps.
# ============================================================

wiki:action
    a rdf:Property ;
    rdfs:label "action" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Links a sub:Affordance descriptor to the mem:Action subclass it performs. Lets an agent ask 'which affordance crystallizes a working note?' by joining over wiki:action = mem:CrystallizeAction." ;
    skos:scopeNote "Single-valued per affordance. Object is a mem:Action subclass IRI (mem:CrystallizeAction, mem:SupersedeAction, etc.). NOT used for read-only affordances (search, derived views) — those don't perform a memory action." ;
    rdfs:domain sub:Affordance ;
    rdfs:range mem:Action ;
    skos:example """
        </vault/meta/affordances/crystallize> a sub:Affordance ;
           wiki:action mem:CrystallizeAction .
    """ ;
    rdfs:seeAlso mem:Action .

wiki:precondition
    a rdf:Property ;
    rdfs:label "precondition" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Natural-language description of what must be true before the agent invokes the affordance. One-sentence narrative; not a formal logical clause." ;
    skos:scopeNote "Use on sub:Affordance descriptors and wiki:Procedure resources. Multiple values allowed when multiple distinct preconditions apply; phrase each as a single declarative sentence. NOT a SHACL constraint — preconditions are informational, not validated by the substrate." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    skos:example """
        <> a sub:Affordance ;
           wiki:precondition "Working note exists at the source URL and conforms to the working shape." .
    """ ;
    rdfs:seeAlso wiki:postcondition .

wiki:postcondition
    a rdf:Property ;
    rdfs:label "postcondition" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Natural-language description of what is true after the affordance is successfully invoked. One-sentence narrative; complements wiki:precondition." ;
    skos:scopeNote "Use on sub:Affordance descriptors and wiki:Procedure resources. Helps the agent confirm a successful invocation (the world matches the postcondition) and detect partial-failure (postcondition false despite no error)." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    skos:example """
        <> a sub:Affordance ;
           wiki:postcondition "Durable resource exists at the destination URL; the working URL returns 404 or a tombstone." .
    """ ;
    rdfs:seeAlso wiki:precondition .

wiki:errorMode
    a rdf:Property ;
    rdfs:label "error mode" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Natural-language description of how the affordance fails (rejection, validation error, conflict, lock timeout). Helps the agent plan its retry/recovery logic and recognize substrate-reported failures correctly." ;
    skos:scopeNote "Use on sub:Affordance descriptors. Repeat once per distinct failure mode (422 on shape violation, 409 on conflict, 412 on precondition fail). Pair each with a single declarative sentence." ;
    rdfs:domain sub:Affordance ;
    rdfs:range xsd:string ;
    skos:example """
        <> a sub:Affordance ;
           wiki:errorMode "422 with sh:ValidationReport body when destination shape rejects the resource." ,
                          "409 when destination URL already exists and If-None-Match was sent." .
    """ ;
    rdfs:seeAlso mem:UnprocessableWrite .

wiki:procedure
    a rdf:Property ;
    rdfs:label "procedure" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Ordered list of LDP/HTTP steps the agent (or substrate) performs to invoke the affordance. Object is an rdf:List of xsd:string values; each string is one step description." ;
    skos:scopeNote "Use on sub:Affordance descriptors and wiki:Procedure resources. The rdf:List preserves step order — agents MUST execute steps in sequence. For unordered prerequisite sets, prefer multiple wiki:precondition triples." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdf:List ;
    skos:example """
        <> a sub:Affordance ;
           wiki:procedure ( "GET <source>" "Validate against destination shape" "PUT to <destination>" "DELETE <source>" ) .
    """ ;
    rdfs:seeAlso wiki:step .

wiki:step
    a rdf:Property ;
    rdfs:label "step" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "A single step in a wiki:Procedure. Alternative to wiki:procedure (rdf:List) for procedures where ordering is encoded via separate sequence triples (e.g., dct:hasPart + rdf:value of an xsd:integer index)." ;
    skos:scopeNote "Prefer wiki:procedure (rdf:List) when possible — rdf:List captures order natively. wiki:step is for shapes that need to attach per-step metadata (timing, owner, retry policy) that doesn't fit inside an rdf:List literal." ;
    rdfs:domain wiki:Procedure ;
    rdfs:range xsd:string ;
    skos:example """
        <> a wiki:Procedure ;
           wiki:step "Step 1: GET source" , "Step 2: PUT destination" .
    """ ;
    rdfs:seeAlso wiki:procedure .

# ============================================================
# Application profile + storage-description predicates
# ============================================================

wiki:WikiMemoryProfile
    a dct:Standard ;
    rdfs:label "Wiki-memory application profile v1.0" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Application profile that pulls together this vocabulary, the 6-shape SHACL catalog at /vault/meta/shapes/, the affordance catalog at /vault/meta/affordances/, and the Type Index (solid:publicTypeIndex) at /vault/settings/publicTypeIndex into a single conformance target. Resources hosted under /vault/wiki/ declare dct:conformsTo wiki:WikiMemoryProfile." ;
    dct:hasVersion "1.0" ;
    skos:scopeNote "Used as the object of dct:conformsTo on wiki resources, container .meta, and overlay manifests. Distinct from wiki:L3Profile (which is the L3 layer identity in the storage description). For the substrate-level conformance declaration, use both." ;
    skos:example """
        <https://pod.vardeman.me/vault/wiki/concepts/foo.md> dct:conformsTo wiki:WikiMemoryProfile .
    """ ;
    rdfs:seeAlso </vault/meta/shapes/> , </vault/meta/affordances/> , wiki:L3Profile .

wiki:L3Profile
    a dct:Standard ;
    rdfs:label "Wiki-memory L3 profile identity" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "The L3 layer identity used by the storage description's wiki:conformsTo triple. Sibling to wiki:WikiMemoryProfile — same conformance target, different role: L3Profile is what the substrate declares as its layer (per D70 L1/L2/L3 stratification); WikiMemoryProfile is what individual resources conform to." ;
    dct:hasVersion "1.0" ;
    skos:scopeNote "Use as the object of wiki:conformsTo on /vault/.well-known/solid. Distinct from wiki:WikiMemoryProfile in role even though the underlying conformance commitments are aligned. Do NOT use both interchangeably — substrate uses L3Profile, individual resources use WikiMemoryProfile." ;
    skos:example """
        # In /vault/.well-known/solid:
        <> wiki:conformsTo wiki:L3Profile .
    """ ;
    rdfs:seeAlso wiki:WikiMemoryProfile .

wiki:conformsTo
    a rdf:Property ;
    rdfs:label "conforms to" ;
    rdfs:isDefinedBy <> ;
    rdfs:comment "Wiki-specific conformance predicate used at the storage-description level. Pairs with wiki:L3Profile / wiki:WikiMemoryProfile. Distinct from dct:conformsTo (used at the resource level and on overlay manifests)." ;
    skos:scopeNote "Use on /vault/.well-known/solid to declare the substrate's L3-layer conformance. For resource-level conformance (individual wiki:Concept/Source/etc. resources), prefer dct:conformsTo wiki:WikiMemoryProfile — that's what shape validators and PROF tooling expect." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range dct:Standard ;
    skos:example """
        # In /vault/.well-known/solid:
        <> wiki:conformsTo wiki:L3Profile .
    """ ;
    rdfs:seeAlso dct:conformsTo .

# ============================================================
# Cross-stratum disjointness (D99 — belt-and-braces enforcement)
# ============================================================
# schema:Event (content memory) is disjoint with mem:Event (substrate signal).
# schema:HowTo (content memory) is disjoint with mem:Action (substrate operation).
# Layer 1 of D99 disjointness; SHACL sh:not constraints in EventShape and
# HowToShape provide Layer 3 belt-and-braces enforcement; path constraints
# in shape-validator provide Layer 2.

schema:Event owl:disjointWith mem:Event .

schema:HowTo owl:disjointWith mem:Action .
