@prefix tmpl:  <https://pod.vardeman.me/vault/ontology/template#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

</vault/meta/templates/org-create.ttl>
    a tmpl:Template ;
    tmpl:validatesAgainst </vault/meta/shapes/organization-card.shacl.ttl#OrganizationCardShape> ;
    tmpl:operation       "PUT" ;
    tmpl:targetContainer </vault/contacts/Organization/> ;
    tmpl:slugAlgorithm   "uuid4" ;

    sh:agentInstruction """
      To create an Organization contact: same UUIDv4/PUT pattern as contact-create.
        1. Generate UUIDv4 for slug
        2. PUT /vault/contacts/Organization/<uuid>/index.ttl with the body below,
           replacing <<...>> placeholders
        3. On 201: PATCH /vault/contacts/people.ttl to add the index entry
           (orgs co-listed with people for unified name lookup, SolidOS convention):
             solid:inserts { <#book> vcard:fn <<ORGANIZATION_NAME>> ;
                                     vcard:hasMember </vault/contacts/Organization/<uuid>/index.ttl#this> . }
        4. On 422: read the SHACL ValidationReport, fix cited fields, retry PUT.

      Minimum to satisfy SHACL: vcard:fn + vcard:inAddressBook + one anchor +
      mem:rationale. Every write carries mem:rationale: the task that triggered
      it, what was concluded, and why — your write-context is unrecoverable
      after this session.
      ROR preferred for institutional orgs (e.g., Notre Dame: https://ror.org/00mkhxb43,
      CI-Compass: https://ror.org/001zwgm84). Fall back to vcard:hasURL for
      commercial or informal organizations without ROR identifiers.
    """ ;

    tmpl:templateBody """
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mem:   <https://pod.vardeman.me/vault/ontology/mem#> .

<>  a vcard:VCard, foaf:OrganizationProfileDocument ;
    foaf:primaryTopic <#this> ;
    dct:creator </vault/profile/card#me> ;
    dct:created  \"<<ISO_DATETIME>>\"^^xsd:dateTime .

<#this>
    a vcard:Organization, foaf:Organization ;
    vcard:fn               \"<<ORGANIZATION_NAME>>\" ;
    vcard:inAddressBook    </vault/contacts/index.ttl#this> ;

    # REQUIRED — the task that triggered this write, what you concluded, and why
    mem:rationale          \"<<RATIONALE>>\" ;

    # AT LEAST ONE anchor — ROR preferred for institutional orgs:
    owl:sameAs             <https://ror.org/<<ROR>>> ;
    # vcard:hasURL         <https://<<HOMEPAGE>>> ;

    # OPTIONAL — add when known
    # vcard:hasAddress     [ ... ] ;
    # vcard:role           \"<<ORG_TYPE>>\" .
""" .
