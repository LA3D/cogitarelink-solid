@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mem:   <https://pod.vardeman.me/vault/ontology/mem#> .

<https://pod.vardeman.me/vault/meta/shapes/organization-card.shacl.ttl#OrganizationCardShape>
    a sh:NodeShape ;
    sh:targetClass vcard:Organization ;
    sh:closed false ;
    sh:agentInstruction """
      A vcard:Organization card. Required: vcard:fn (one), vcard:inAddressBook
      (one), at least one external anchor — owl:sameAs (ROR strongly preferred
      for institutional orgs) or vcard:hasURL (for non-ROR orgs) — and
      mem:rationale. ROR provides stable cross-system identity
      (https://ror.org/...). Without an anchor, the organization can't be
      matched across pods or to external knowledge bases.
      Every write carries mem:rationale: the task that triggered it, what was
      concluded, and why — your write-context is unrecoverable after this session.
    """ ;

    sh:property [
        sh:path vcard:fn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Organization must have exactly one vcard:fn (display name)." ;
    ] ;

    sh:property [
        sh:path vcard:inAddressBook ;
        sh:minCount 1 ;
        sh:hasValue <https://pod.vardeman.me/vault/contacts/index.ttl#this> ;
        sh:nodeKind sh:IRI ;
        sh:message "Organization must declare vcard:inAddressBook <https://pod.vardeman.me/vault/contacts/index.ttl#this>." ;
    ] ;

    # SP2 §6 agentic write contract (Turtle lane; twin-probe grounded 2026-06-11):
    # REQUIRED — agents fill required literals richly and never volunteer optional
    # ones (e5b-write; D112 35/35). The laden instruction lives on the SHAPE (read
    # pre-write 9/9); sh:message only fires on violation.
    sh:property [
        sh:path mem:rationale ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "mem:rationale is required — record the task that triggered this write, what you concluded, and why, including what you consulted. Do not merely restate the record's name; a future agent audits this context before trusting it." ;
    ] ;

    sh:or (
        [ sh:property [ sh:path owl:sameAs ;     sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
        [ sh:property [ sh:path vcard:hasURL ;   sh:minCount 1 ; sh:nodeKind sh:IRI ] ]
    ) ;
    sh:message "Organization must have at least one anchor: owl:sameAs (ROR preferred) or vcard:hasURL." .
