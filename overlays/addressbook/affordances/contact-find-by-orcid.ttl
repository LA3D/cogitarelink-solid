@prefix wiki:  <https://pod.vardeman.me/vault/ontology/wiki#> .
@prefix sub:      <https://pod.vardeman.me/vault/ontology/substrate#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix prof:     <http://www.w3.org/ns/dx/prof/> .
@prefix wikirole: <https://pod.vardeman.me/vault/ontology/wikirole#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:      <http://purl.org/dc/terms/> .

</vault/meta/affordances/contact-find-by-orcid.ttl>
    a sub:QueryAffordance , prof:ResourceDescriptor ;
    prof:hasRole wikirole:query-affordance ;
    rdfs:label "Find contact by ORCID" ;
    dct:conformsTo <http://www.w3.org/TR/dx-prof/> ;
    sub:installedBy <https://pod.vardeman.me/vault/ontology/overlay#addressbook> ;
    sh:agentInstruction """
      Canonical identity reconciliation: given an ORCID IRI, find the matching
      Person card. Useful for cross-pod identity resolution when an agent receives
      a WebID or ORCID from an external source and needs to locate the local card.

      Parameter: $orcid — the full ORCID IRI as a named node, e.g.,
      <https://orcid.org/0000-0003-4091-6059>. Pass the angle-bracketed form
      in SPARQL; the affordance engine substitutes it as an IRI, not a string.

      Sources: all /vault/contacts/Person/*/index.ttl files (cross-resource query).
      The agent may need to enumerate cards via LDP listing of
      </vault/contacts/Person/> and issue the query per card, or use Comunica
      link-traversal with the Person container as entry point.

      Returns 0..1 ?person IRIs. Zero means no card has been created for this
      ORCID yet; the agent should prompt the user or create a stub card.
    """ ;
    sub:selectQuery """
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?person WHERE {
  ?person owl:sameAs $orcid .
}
    """ .
